<UserControl
    x:Class="URMS.WinUI.Controls.WeatherAnimation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="90" Height="90">

    <Grid>

        <!-- ══ 晴れ (Sunny) ════════════════════════════════════════════ -->
        <Canvas x:Name="SunCanvas" Width="90" Height="90" Visibility="Collapsed">
            <!-- 外側グロー -->
            <Ellipse Canvas.Left="22" Canvas.Top="22" Width="46" Height="46"
                     Fill="#00d4f0" Opacity="0.15"/>
            <!-- 太陽本体 -->
            <Ellipse x:Name="SunCore"
                     Canvas.Left="28" Canvas.Top="28" Width="34" Height="34"
                     Fill="#FFD84D">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="SunRot" CenterX="17" CenterY="17"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- 光線 8本 -->
            <Canvas x:Name="SunRays" Canvas.Left="45" Canvas.Top="45">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="RaysRot"/>
                </Canvas.RenderTransform>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9">
                    <Line.RenderTransform><RotateTransform Angle="0"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75">
                    <Line.RenderTransform><RotateTransform Angle="45"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9">
                    <Line.RenderTransform><RotateTransform Angle="90"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75">
                    <Line.RenderTransform><RotateTransform Angle="135"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9">
                    <Line.RenderTransform><RotateTransform Angle="180"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75">
                    <Line.RenderTransform><RotateTransform Angle="225"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9">
                    <Line.RenderTransform><RotateTransform Angle="270"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-26" X2="0" Y2="-36" Stroke="#FFD84D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75">
                    <Line.RenderTransform><RotateTransform Angle="315"/></Line.RenderTransform>
                </Line>
            </Canvas>
            <Canvas.Resources>
                <Storyboard x:Name="SunAnim" RepeatBehavior="Forever">
                    <DoubleAnimation
                        Storyboard.TargetName="RaysRot"
                        Storyboard.TargetProperty="Angle"
                        From="0" To="360"
                        Duration="0:0:12"/>
                </Storyboard>
            </Canvas.Resources>
        </Canvas>

        <!-- ══ 晴れ時々くもり (PartlyCloudy) ══════════════════════════ -->
        <Canvas x:Name="PartlyCloudyCanvas" Width="90" Height="90" Visibility="Collapsed">
            <!-- 太陽（右上） -->
            <Canvas x:Name="PCRays" Canvas.Left="62" Canvas.Top="28">
                <Canvas.RenderTransform><RotateTransform x:Name="PCRaysRot"/></Canvas.RenderTransform>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="0"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="45"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="90"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="135"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="180"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="225"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="270"/></Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="-14" X2="0" Y2="-20" Stroke="#FFD84D" StrokeThickness="2.5" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform Angle="315"/></Line.RenderTransform>
                </Line>
            </Canvas>
            <Ellipse Canvas.Left="52" Canvas.Top="18" Width="20" Height="20" Fill="#FFD84D"/>
            <!-- 雲 -->
            <Path Canvas.Left="8" Canvas.Top="38" Fill="#c8d8f0">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="10,28">
                            <ArcSegment Point="28,28" Size="10,10" SweepDirection="Clockwise" IsLargeArc="False"/>
                            <ArcSegment Point="46,28" Size="12,12" SweepDirection="Clockwise" IsLargeArc="False"/>
                            <ArcSegment Point="56,38" Size="10,10" SweepDirection="Clockwise" IsLargeArc="False"/>
                            <LineSegment Point="4,38"/>
                            <ArcSegment Point="10,28" Size="8,8"  SweepDirection="Clockwise" IsLargeArc="False"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <Canvas.Resources>
                <Storyboard x:Name="PCCloudAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="PCRaysRot"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:10"/>
                </Storyboard>
            </Canvas.Resources>
        </Canvas>

        <!-- ══ くもり (Cloudy) ═══════════════════════════════════════════ -->
        <Canvas x:Name="CloudyCanvas" Width="90" Height="90" Visibility="Collapsed">
            <!-- 奥の雲（薄い） -->
            <Ellipse Canvas.Left="28" Canvas.Top="20" Width="38" Height="26" Fill="#8090a8"/>
            <Ellipse Canvas.Left="40" Canvas.Top="14" Width="30" Height="24" Fill="#8090a8"/>
            <!-- 手前の雲（明るい） -->
            <Ellipse x:Name="CldFront1" Canvas.Left="10" Canvas.Top="36" Width="52" Height="30" Fill="#b0c4de">
                <Ellipse.RenderTransform><TranslateTransform x:Name="CldFrontTx1"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="CldFront2" Canvas.Left="22" Canvas.Top="28" Width="40" Height="26" Fill="#b0c4de">
                <Ellipse.RenderTransform><TranslateTransform x:Name="CldFrontTx2"/></Ellipse.RenderTransform>
            </Ellipse>
            <Canvas.Resources>
                <Storyboard x:Name="CloudyAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="CldFrontTx1"
                                     Storyboard.TargetProperty="X"
                                     From="-4" To="4"
                                     Duration="0:0:3" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="CldFrontTx2"
                                     Storyboard.TargetProperty="X"
                                     From="3" To="-3"
                                     Duration="0:0:4" AutoReverse="True"/>
                </Storyboard>
            </Canvas.Resources>
        </Canvas>

        <!-- ══ 雨 (Rainy) ════════════════════════════════════════════ -->
        <Canvas x:Name="RainyCanvas" Width="90" Height="90" Visibility="Collapsed">
            <!-- 雲 -->
            <Ellipse Canvas.Left="12" Canvas.Top="8"  Width="50" Height="30" Fill="#7090b0"/>
            <Ellipse Canvas.Left="28" Canvas.Top="4"  Width="36" Height="28" Fill="#7090b0"/>
            <Ellipse Canvas.Left="38" Canvas.Top="12" Width="40" Height="26" Fill="#8090a8"/>
            <!-- 雨粒 7本 -->
            <Line x:Name="R1" X1="22" Y1="48" X2="18" Y2="62" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.9">
                <Line.RenderTransform><TranslateTransform x:Name="RTx1"/></Line.RenderTransform>
            </Line>
            <Line x:Name="R2" X1="34" Y1="48" X2="30" Y2="62" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.7">
                <Line.RenderTransform><TranslateTransform x:Name="RTx2"/></Line.RenderTransform>
            </Line>
            <Line x:Name="R3" X1="46" Y1="48" X2="42" Y2="62" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.9">
                <Line.RenderTransform><TranslateTransform x:Name="RTx3"/></Line.RenderTransform>
            </Line>
            <Line x:Name="R4" X1="58" Y1="48" X2="54" Y2="62" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.6">
                <Line.RenderTransform><TranslateTransform x:Name="RTx4"/></Line.RenderTransform>
            </Line>
            <Line x:Name="R5" X1="28" Y1="60" X2="24" Y2="74" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.8">
                <Line.RenderTransform><TranslateTransform x:Name="RTx5"/></Line.RenderTransform>
            </Line>
            <Line x:Name="R6" X1="42" Y1="60" X2="38" Y2="74" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.7">
                <Line.RenderTransform><TranslateTransform x:Name="RTx6"/></Line.RenderTransform>
            </Line>
            <Line x:Name="R7" X1="54" Y1="58" X2="50" Y2="72" Stroke="#5bc8ff" StrokeThickness="2" StrokeEndLineCap="Round" Opacity="0.85">
                <Line.RenderTransform><TranslateTransform x:Name="RTx7"/></Line.RenderTransform>
            </Line>
            <Canvas.Resources>
                <Storyboard x:Name="RainAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="RTx1" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.0"/>
                    <DoubleAnimation Storyboard.TargetName="RTx2" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="RTx3" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="RTx4" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="RTx5" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.05"/>
                    <DoubleAnimation Storyboard.TargetName="RTx6" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="RTx7" Storyboard.TargetProperty="Y" From="-10" To="16" Duration="0:0:0.7" BeginTime="0:0:0.15"/>
                </Storyboard>
            </Canvas.Resources>
        </Canvas>

        <!-- ══ 雪 (Snowy) ════════════════════════════════════════════ -->
        <Canvas x:Name="SnowyCanvas" Width="90" Height="90" Visibility="Collapsed">
            <!-- 雲 -->
            <Ellipse Canvas.Left="10" Canvas.Top="8"  Width="52" Height="30" Fill="#8898b0"/>
            <Ellipse Canvas.Left="26" Canvas.Top="4"  Width="38" Height="28" Fill="#8898b0"/>
            <!-- 雪片 6個 -->
            <Ellipse x:Name="S1" Canvas.Left="19" Canvas.Top="44" Width="7" Height="7" Fill="White" Opacity="0.9">
                <Ellipse.RenderTransform><TranslateTransform x:Name="STx1"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="S2" Canvas.Left="32" Canvas.Top="44" Width="6" Height="6" Fill="White" Opacity="0.7">
                <Ellipse.RenderTransform><TranslateTransform x:Name="STx2"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="S3" Canvas.Left="46" Canvas.Top="44" Width="7" Height="7" Fill="White" Opacity="0.85">
                <Ellipse.RenderTransform><TranslateTransform x:Name="STx3"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="S4" Canvas.Left="26" Canvas.Top="58" Width="6" Height="6" Fill="White" Opacity="0.75">
                <Ellipse.RenderTransform><TranslateTransform x:Name="STx4"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="S5" Canvas.Left="40" Canvas.Top="60" Width="7" Height="7" Fill="White" Opacity="0.9">
                <Ellipse.RenderTransform><TranslateTransform x:Name="STx5"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="S6" Canvas.Left="54" Canvas.Top="56" Width="5" Height="5" Fill="White" Opacity="0.65">
                <Ellipse.RenderTransform><TranslateTransform x:Name="STx6"/></Ellipse.RenderTransform>
            </Ellipse>
            <Canvas.Resources>
                <Storyboard x:Name="SnowAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="STx1" Storyboard.TargetProperty="Y" From="-8" To="18" Duration="0:0:1.2" BeginTime="0:0:0.0"/>
                    <DoubleAnimation Storyboard.TargetName="STx2" Storyboard.TargetProperty="Y" From="-8" To="18" Duration="0:0:1.5" BeginTime="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="STx3" Storyboard.TargetProperty="Y" From="-8" To="18" Duration="0:0:1.1" BeginTime="0:0:0.6"/>
                    <DoubleAnimation Storyboard.TargetName="STx4" Storyboard.TargetProperty="Y" From="-8" To="18" Duration="0:0:1.4" BeginTime="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="STx5" Storyboard.TargetProperty="Y" From="-8" To="18" Duration="0:0:1.2" BeginTime="0:0:0.7"/>
                    <DoubleAnimation Storyboard.TargetName="STx6" Storyboard.TargetProperty="Y" From="-8" To="18" Duration="0:0:1.6" BeginTime="0:0:0.4"/>
                    <DoubleAnimation Storyboard.TargetName="STx1" Storyboard.TargetProperty="X" From="-4" To="4" Duration="0:0:2.0" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="STx3" Storyboard.TargetProperty="X" From="4" To="-4" Duration="0:0:2.5" AutoReverse="True"/>
                </Storyboard>
            </Canvas.Resources>
        </Canvas>

        <!-- ══ 夜晴れ (ClearNight) ════════════════════════════════════ -->
        <Canvas x:Name="NightCanvas" Width="90" Height="90" Visibility="Collapsed">
            <!-- 月 -->
            <Path Canvas.Left="20" Canvas.Top="10" Fill="#d0e8ff">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="35,5">
                            <ArcSegment Point="35,65" Size="30,30" SweepDirection="Clockwise" IsLargeArc="True"/>
                            <ArcSegment Point="35,5"  Size="22,22" SweepDirection="CounterClockwise" IsLargeArc="True"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <!-- 星 -->
            <Ellipse x:Name="Star1" Canvas.Left="64" Canvas.Top="12" Width="5" Height="5" Fill="White" Opacity="0.9">
                <Ellipse.RenderTransform><ScaleTransform x:Name="StarScale1" CenterX="2.5" CenterY="2.5"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Star2" Canvas.Left="72" Canvas.Top="28" Width="4" Height="4" Fill="White" Opacity="0.7">
                <Ellipse.RenderTransform><ScaleTransform x:Name="StarScale2" CenterX="2" CenterY="2"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Star3" Canvas.Left="58" Canvas.Top="40" Width="3" Height="3" Fill="White" Opacity="0.8">
                <Ellipse.RenderTransform><ScaleTransform x:Name="StarScale3" CenterX="1.5" CenterY="1.5"/></Ellipse.RenderTransform>
            </Ellipse>
            <Canvas.Resources>
                <Storyboard x:Name="NightAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="StarScale1" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:1.5" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="StarScale1" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:1.5" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="StarScale2" Storyboard.TargetProperty="ScaleX" From="1" To="1.5" Duration="0:0:2.0" AutoReverse="True" BeginTime="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="StarScale2" Storyboard.TargetProperty="ScaleY" From="1" To="1.5" Duration="0:0:2.0" AutoReverse="True" BeginTime="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="StarScale3" Storyboard.TargetProperty="ScaleX" From="1" To="1.6" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="StarScale3" Storyboard.TargetProperty="ScaleY" From="1" To="1.6" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.3"/>
                </Storyboard>
            </Canvas.Resources>
        </Canvas>

    </Grid>
</UserControl>
