<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.WorkflowCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid>
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="#24364C" Background="#0E131D" Padding="12,10,12,10">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoCommit" Grid.Row="0" Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource AccentCyanBrush}"/>
            <Ellipse x:Name="DotCommit" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtCommit" Grid.Row="2" Text="Commit" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource AccentCyanBrush}"/>
            <TextBlock x:Name="TxtMetaCommit" Grid.Row="3" Text="OK" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
          <TextBlock Text="->" Foreground="#6A7C94" VerticalAlignment="Center"/>
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoBuild" Grid.Row="0" Glyph="&#xE956;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <Ellipse x:Name="DotBuild" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtBuild" Grid.Row="2" Text="Build" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <TextBlock x:Name="TxtMetaBuild" Grid.Row="3" Text="OK" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
          <TextBlock Text="->" Foreground="#6A7C94" VerticalAlignment="Center"/>
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoTest" Grid.Row="0" Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <Ellipse x:Name="DotTest" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtTest" Grid.Row="2" Text="Test" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <TextBlock x:Name="TxtMetaTest" Grid.Row="3" Text="OK" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
          <TextBlock Text="->" Foreground="#6A7C94" VerticalAlignment="Center"/>
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoCI" Grid.Row="0" Glyph="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <Ellipse x:Name="DotCI" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtCI" Grid.Row="2" Text="CI" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <TextBlock x:Name="TxtMetaCI" Grid.Row="3" Text="RUN" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
          <TextBlock Text="->" Foreground="#6A7C94" VerticalAlignment="Center"/>
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoCD" Grid.Row="0" Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <Ellipse x:Name="DotCD" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtCD" Grid.Row="2" Text="CD" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <TextBlock x:Name="TxtMetaCD" Grid.Row="3" Text="WAIT" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
          <TextBlock Text="->" Foreground="#6A7C94" VerticalAlignment="Center"/>
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoDeploy" Grid.Row="0" Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <Ellipse x:Name="DotDeploy" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtDeploy" Grid.Row="2" Text="Deploy" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <TextBlock x:Name="TxtMetaDeploy" Grid.Row="3" Text="WAIT" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
          <TextBlock Text="->" Foreground="#6A7C94" VerticalAlignment="Center"/>
          <Grid MinWidth="68">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <FontIcon x:Name="IcoPR" Grid.Row="0" Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <Ellipse x:Name="DotPR" Grid.Row="1" Width="10" Height="10" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock x:Name="TxtPR" Grid.Row="2" Text="PR" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            <TextBlock x:Name="TxtMetaPR" Grid.Row="3" Text="WAIT" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>

    <Rectangle IsHitTestVisible="False" Opacity="0.02" RadiusX="8" RadiusY="8">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#44FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Border IsHitTestVisible="False" CornerRadius="8" BorderThickness="1" BorderBrush="#66FFFFFF" Opacity="0.05"/>
  </Grid>
</UserControl>
