<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:URMS.WinUI.Controls"
    Background="Transparent">

  <Page.Resources>
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{ThemeResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="CharacterSpacing" Value="160"/>
      <Setter Property="Foreground" Value="{ThemeResource SectionHeaderBrush}"/>
    </Style>

    <Style x:Key="SectionShellStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource MaterialStrokeSoftBrush}"/>
      <Setter Property="Background" Value="{ThemeResource MaterialPanelBrush}"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="SidebarMenuButtonStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="#10213858"/>
      <Setter Property="BorderBrush" Value="#2A4A6FA2"/>
      <Setter Property="Foreground" Value="{ThemeResource ValueBrush}"/>
      <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Page.Resources>

  <Grid Padding="20">
    <Rectangle Opacity="0.018" Fill="{ThemeResource GlobalNoiseBrush}"/>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="214"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              CornerRadius="18"
              Padding="16"
              BorderBrush="{ThemeResource MaterialStrokeSoftBrush}"
              BorderThickness="1"
              Background="{ThemeResource MaterialPanelStrongBrush}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="URMS" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="26" Foreground="{ThemeResource HeaderTitleBrush}"/>
            <TextBlock Text="Dashboard" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="130" Foreground="{ThemeResource LabelBrush}"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Style="{StaticResource SidebarMenuButtonStyle}" Content="Dashboard"/>
            <Button Style="{StaticResource SidebarMenuButtonStyle}" Content="Systems"/>
            <Button Style="{StaticResource SidebarMenuButtonStyle}" Content="Workflows"/>
            <Button Style="{StaticResource SidebarMenuButtonStyle}" Content="Logs"/>
            <Button Style="{StaticResource SidebarMenuButtonStyle}" Content="Settings"/>
            <Button Style="{StaticResource SidebarMenuButtonStyle}" Content="Profile"/>
          </StackPanel>

          <StackPanel Grid.Row="2">
            <TextBlock Text="SESSION" FontFamily="{ThemeResource MonoFontFamily}" FontSize="9" CharacterSpacing="150" Foreground="{ThemeResource LabelBrush}"/>
            <TextBlock x:ConnectionId='36' x:Name="TxtSessionId" Text="---" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="20" Foreground="{ThemeResource ValueBrush}"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="4,0,0,4">
          <Border Style="{StaticResource SectionShellStyle}" Padding="20,16">
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="DASHBOARD" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="28" Foreground="{ThemeResource HeaderTitleBrush}"/>
                <TextBlock Text="Liquid Glass command surface" FontFamily="{ThemeResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource HeroSubBrush}"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="10" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Background="#16334D84" Padding="10,8">
                <TextBlock Text="Search system, logs, workflow..." Foreground="{ThemeResource LabelBrush}"/>
              </Border>
              <Border Grid.Column="2" CornerRadius="10" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Background="#16334D84" Padding="10,8">
                <TextBlock Text="Operator: Takuya" Foreground="{ThemeResource ValueBrush}"/>
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource SectionShellStyle}">
            <StackPanel Spacing="14">
              <TextBlock Text="SYSTEM LAYER" Style="{StaticResource SectionLabelStyle}"/>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ctrl:CardControl x:ConnectionId='23' x:Name="CardSysmon" Grid.Column="0" MinHeight="248" IsPrimaryTone="True" MaterialIntensity="1.9" OpticalDepth="1.8" ShadowDepth="1.9" InfoDensity="1.15" TitleText="SYSTEM HEALTH" MainValueText="98 / 100" SubInfoText="Core integrity stable" IconGlyph="&#xE9CE;">
                  <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <ctrl:AnalogGauge x:ConnectionId='33' x:Name="GaugeCpu" Grid.Column="0" Value="72" Label="CPU" GaugeColor="#79BFFF" Height="66"/>
                      <ctrl:AnalogGauge x:ConnectionId='34' x:Name="GaugeRam" Grid.Column="1" Value="58" Label="RAM" GaugeColor="#6CD9E2" Height="66"/>
                      <ctrl:AnalogGauge x:ConnectionId='35' x:Name="GaugeGpu" Grid.Column="2" Value="45" Label="GPU" GaugeColor="#6FA7FF" Height="66"/>
                    </Grid>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='24' x:Name="CardTask" Grid.Column="1" MinHeight="248" IsPrimaryTone="True" MaterialIntensity="1.85" OpticalDepth="1.7" ShadowDepth="1.8" InfoDensity="1.1" TitleText="TASKS" MainValueText="5 / 8" SubInfoText="Execution queue" IconGlyph="&#xE823;">
                  <StackPanel Spacing="10">
                    <TextBlock x:ConnectionId='31' x:Name="TxtCardTask" Text="TASKS" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource CardTitleBrush}"/>
                    <ProgressBar x:ConnectionId='32' x:Name="BarTaskPct" Value="62" Height="8" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" CornerRadius="10" Background="#1831505E" Padding="8"><TextBlock Text="Done 5" Foreground="{ThemeResource ValueBrush}"/></Border>
                      <Border Grid.Column="1" CornerRadius="10" Background="#1831505E" Padding="8"><TextBlock Text="Open 3" Foreground="{ThemeResource ValueBrush}"/></Border>
                    </Grid>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='25' x:Name="CardWeather" Grid.Column="2" MinHeight="248" MaterialIntensity="1.25" OpticalDepth="1.2" ShadowDepth="1.25" InfoDensity="0.96" TitleText="WEATHER" MainValueText="22°C" SubInfoText="Tokyo" IconGlyph="&#xE706;">
                  <StackPanel Spacing="10">
                    <TextBlock x:ConnectionId='27' x:Name="TxtCardWeather" Text="WEATHER" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource CardTitleBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ctrl:WeatherAnimation x:ConnectionId='28' x:Name="WxAnim" Condition="partly_cloudy" Width="54" Height="54"/>
                      <StackPanel>
                        <TextBlock x:ConnectionId='29' x:Name="TxtWeatherTemp" Text="22°C" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="26" Foreground="{ThemeResource ValueBrush}"/>
                        <TextBlock x:ConnectionId='30' x:Name="TxtWeatherDesc" Text="Tokyo · Minato" Foreground="{ThemeResource LabelBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='26' x:Name="CardSecurity" Grid.Column="3" MinHeight="248" MaterialIntensity="1.25" OpticalDepth="1.2" ShadowDepth="1.2" InfoDensity="0.96" TitleText="SECURITY" MainValueText="PROTECTED" SubInfoText="No critical issue" IconGlyph="&#xE72E;">
                  <StackPanel Spacing="10">
                    <Border CornerRadius="10" Background="#1831505E" Padding="10">
                      <TextBlock Text="Patch compliance 99%" Foreground="{ThemeResource ValueBrush}"/>
                    </Border>
                    <Border CornerRadius="10" Background="#1831505E" Padding="10">
                      <TextBlock Text="Threat score 12" Foreground="{ThemeResource ValueBrush}"/>
                    </Border>
                  </StackPanel>
                </ctrl:CardControl>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SectionShellStyle}">
            <StackPanel Spacing="14">
              <TextBlock Text="SUBSYSTEM LAYER" Style="{StaticResource SectionLabelStyle}"/>
              <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ctrl:CardControl x:ConnectionId='9' x:Name="CardSchedule" Grid.Row="0" Grid.Column="0" MinHeight="190" MaterialIntensity="1.08" OpticalDepth="1.0" ShadowDepth="1.05" InfoDensity="0.9" TitleText="ASSET" MainValueText="124" SubInfoText="Managed assets" IconGlyph="&#xE8D2;">
                  <StackPanel Spacing="8">
                    <TextBlock x:ConnectionId='22' x:Name="TxtCardSchedule" Text="ASSET" FontFamily="{ThemeResource MonoFontFamily}" Foreground="{ThemeResource CardTitleBrush}"/>
                    <TextBlock Text="Discovery 12 pending" Foreground="{ThemeResource LabelBrush}"/>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='10' x:Name="CardCalendar" Grid.Row="0" Grid.Column="1" MinHeight="190" MaterialIntensity="1.08" OpticalDepth="1.0" ShadowDepth="1.05" InfoDensity="0.9" TitleText="AUTH" MainValueText="82%" SubInfoText="MFA coverage" IconGlyph="&#xE77B;">
                  <StackPanel Spacing="10">
                    <Border CornerRadius="10" Background="#1831505E" Padding="10">
                      <TextBlock Text="Policy pass ratio" Foreground="{ThemeResource ValueBrush}"/>
                    </Border>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='11' x:Name="CardNetwork" Grid.Row="0" Grid.Column="2" MinHeight="190" MaterialIntensity="1.08" OpticalDepth="1.0" ShadowDepth="1.05" InfoDensity="0.9" TitleText="MONITOR" MainValueText="24 hosts" SubInfoText="Latency and stream" IconGlyph="&#xE128;">
                  <StackPanel Spacing="10">
                    <Canvas x:ConnectionId='21' x:Name="NetWaveCanvas" Height="40"/>
                    <TextBlock Text="Latency 12 ms / uptime 100%" Foreground="{ThemeResource LabelBrush}"/>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='12' x:Name="SubAsset" Grid.Row="1" Grid.Column="0" MinHeight="176" MaterialIntensity="1.05" OpticalDepth="0.95" ShadowDepth="1.0" InfoDensity="0.88" TitleText="DISK" MainValueText="CAPACITY" SubInfoText="Storage cluster" IconGlyph="&#xE7F1;">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="C:" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
                      <ProgressBar x:ConnectionId='19' Grid.Column="1" x:Name="BarDiskC" Height="7" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                      <TextBlock x:ConnectionId='20' Grid.Column="2" x:Name="TxtDiskC" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="D:" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
                      <ProgressBar x:ConnectionId='17' Grid.Column="1" x:Name="BarDiskD" Height="7" Foreground="{ThemeResource AccentTealBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                      <TextBlock x:ConnectionId='18' Grid.Column="2" x:Name="TxtDiskD" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="NAS" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
                      <ProgressBar x:ConnectionId='15' Grid.Column="1" x:Name="BarDiskNas" Height="7" Foreground="{ThemeResource AccentPurpleBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                      <TextBlock x:ConnectionId='16' Grid.Column="2" x:Name="TxtDiskNas" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                    </Grid>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='13' x:Name="SubSecurity" Grid.Row="1" Grid.Column="1" MinHeight="176" MaterialIntensity="1.05" OpticalDepth="0.95" ShadowDepth="1.0" InfoDensity="0.88" TitleText="DELIVERY" MainValueText="QUEUE" SubInfoText="Deployment flow" IconGlyph="&#xE8A7;">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Ready 6 / Running 2" Foreground="{ThemeResource ValueBrush}"/>
                    <TextBlock Text="Rollback window: open" Foreground="{ThemeResource LabelBrush}"/>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='14' x:Name="SubExtra" Grid.Row="1" Grid.Column="2" MinHeight="176" MaterialIntensity="1.05" OpticalDepth="0.95" ShadowDepth="1.0" InfoDensity="0.88" TitleText="CONTENT" MainValueText="SYNC" SubInfoText="Index and cache" IconGlyph="&#xE8F1;">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Last sync: 2m ago" Foreground="{ThemeResource ValueBrush}"/>
                    <TextBlock Text="Delta package: 14" Foreground="{ThemeResource LabelBrush}"/>
                  </StackPanel>
                </ctrl:CardControl>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SectionShellStyle}">
            <StackPanel Spacing="14">
              <TextBlock Text="OPERATION LAYER" Style="{StaticResource SectionLabelStyle}"/>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.05*"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>

                <ctrl:CardControl x:ConnectionId='2' x:Name="OperationStateCard" Grid.Column="0" MinHeight="214" MaterialIntensity="0.72" OpticalDepth="0.52" ShadowDepth="0.72" InfoDensity="0.78" TitleText="RECENT LOGS" MainValueText="NOMINAL" SubInfoText="Matte low-emission" IconGlyph="&#xE7BA;">
                  <StackPanel Spacing="8">
                    <TextBlock x:ConnectionId='6' x:Name="TxtOpHealth" Text="NOMINAL" Foreground="{ThemeResource ValueBrush}"/>
                    <TextBlock x:ConnectionId='7' x:Name="TxtOpAlerts" Text="Alerts: 0" Foreground="{ThemeResource AccentAmberBrush}"/>
                    <TextBlock x:ConnectionId='8' x:Name="TxtOpTasks" Text="Running Tasks: 2" Foreground="{ThemeResource LabelBrush}"/>
                  </StackPanel>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='3' x:Name="OperationWorkflowCard" Grid.Column="1" MinHeight="214" MaterialIntensity="0.72" OpticalDepth="0.52" ShadowDepth="0.72" InfoDensity="0.78" TitleText="RECENT EVENTS" MainValueText="PIPELINE" SubInfoText="Operational stream" IconGlyph="&#xE7C1;">
                  <ctrl:WorkflowCard x:ConnectionId='5' x:Name="OpWorkflowCard"/>
                </ctrl:CardControl>

                <ctrl:CardControl x:ConnectionId='4' x:Name="OperationActionCard" Grid.Column="2" MinHeight="214" MaterialIntensity="0.72" OpticalDepth="0.52" ShadowDepth="0.72" InfoDensity="0.78" TitleText="RECENT OPERATIONS" MainValueText="5" SubInfoText="Action list" IconGlyph="&#xE8EF;">
                  <StackPanel Spacing="8">
                    <Border CornerRadius="8" Background="#1522323F" Padding="8"><TextBlock Text="Lock device" Foreground="{ThemeResource ValueBrush}"/></Border>
                    <Border CornerRadius="8" Background="#1522323F" Padding="8"><TextBlock Text="Restart service" Foreground="{ThemeResource ValueBrush}"/></Border>
                    <Border CornerRadius="8" Background="#1522323F" Padding="8"><TextBlock Text="Validate deploy" Foreground="{ThemeResource ValueBrush}"/></Border>
                  </StackPanel>
                </ctrl:CardControl>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>

