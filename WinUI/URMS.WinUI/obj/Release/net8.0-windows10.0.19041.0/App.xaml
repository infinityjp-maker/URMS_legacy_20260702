<Application
    x:Class="URMS.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:URMS.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- URMS Cyberpunk Theme Resources -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Backgrounds -->
                    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#03050a"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#020408"/>
                    <!-- Text -->
                    <SolidColorBrush x:Key="HeaderTitleBrush"        Color="#00f7ff"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush"     Color="#1a3050"/>
                    <SolidColorBrush x:Key="LabelBrush"              Color="#2a4060"/>
                    <SolidColorBrush x:Key="ValueBrush"              Color="#c8d8f8"/>
                    <SolidColorBrush x:Key="CardTitleBrush"          Color="#4a70a0"/>
                    <!-- Hero -->
                    <SolidColorBrush x:Key="HeroCyanBrush"           Color="#00f7ff"/>
                    <SolidColorBrush x:Key="HeroSubBrush"            Color="#2a4060"/>
                    <!-- Accents -->
                    <SolidColorBrush x:Key="AccentCyanBrush"         Color="#00f7ff"/>
                    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#00ff88"/>
                    <SolidColorBrush x:Key="AccentAmberBrush"        Color="#ffb800"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush"      Color="#ff00cc"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush"       Color="#c060ff"/>
                    <SolidColorBrush x:Key="AccentRedBrush"          Color="#ff4080"/>
                    <SolidColorBrush x:Key="AccentTealBrush"         Color="#00ffcc"/>
                    <!-- Cards / UI Elements -->
                    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="#04090f"/>
                    <SolidColorBrush x:Key="CardBorderBrush"         Color="#1400f7ff"/>
                    <SolidColorBrush x:Key="CardHeaderBrush"         Color="#0a1825"/>
                    <SolidColorBrush x:Key="CardValueBrush"          Color="#00f7ff"/>
                    <SolidColorBrush x:Key="CardLabelBrush"          Color="#1a3050"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush"      Color="#00f7ff"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush"      Color="#081420"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#03050a"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#020408"/>
                    <SolidColorBrush x:Key="HeaderTitleBrush"        Color="#00f7ff"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush"     Color="#1a3050"/>
                    <SolidColorBrush x:Key="LabelBrush"              Color="#2a4060"/>
                    <SolidColorBrush x:Key="ValueBrush"              Color="#c8d8f8"/>
                    <SolidColorBrush x:Key="CardTitleBrush"          Color="#4a70a0"/>
                    <SolidColorBrush x:Key="HeroCyanBrush"           Color="#00f7ff"/>
                    <SolidColorBrush x:Key="HeroSubBrush"            Color="#2a4060"/>
                    <SolidColorBrush x:Key="AccentCyanBrush"         Color="#00f7ff"/>
                    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#00ff88"/>
                    <SolidColorBrush x:Key="AccentAmberBrush"        Color="#ffb800"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush"      Color="#ff00cc"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush"       Color="#c060ff"/>
                    <SolidColorBrush x:Key="AccentRedBrush"          Color="#ff4080"/>
                    <SolidColorBrush x:Key="AccentTealBrush"         Color="#00ffcc"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="#04090f"/>
                    <SolidColorBrush x:Key="CardBorderBrush"         Color="#1400f7ff"/>
                    <SolidColorBrush x:Key="CardHeaderBrush"         Color="#0a1825"/>
                    <SolidColorBrush x:Key="CardValueBrush"          Color="#00f7ff"/>
                    <SolidColorBrush x:Key="CardLabelBrush"          Color="#1a3050"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush"      Color="#00f7ff"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush"      Color="#081420"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="Black"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="Black"/>
                    <SolidColorBrush x:Key="HeaderTitleBrush"        Color="White"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush"     Color="White"/>
                    <SolidColorBrush x:Key="LabelBrush"              Color="White"/>
                    <SolidColorBrush x:Key="ValueBrush"              Color="White"/>
                    <SolidColorBrush x:Key="CardTitleBrush"          Color="White"/>
                    <SolidColorBrush x:Key="HeroCyanBrush"           Color="#00f7ff"/>
                    <SolidColorBrush x:Key="HeroSubBrush"            Color="White"/>
                    <SolidColorBrush x:Key="AccentCyanBrush"         Color="#00f7ff"/>
                    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#00ff88"/>
                    <SolidColorBrush x:Key="AccentAmberBrush"        Color="#ffb300"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush"      Color="#ff00cc"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush"       Color="#b000ff"/>
                    <SolidColorBrush x:Key="AccentRedBrush"          Color="#ff3333"/>
                    <SolidColorBrush x:Key="AccentTealBrush"         Color="#00e5cc"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="Black"/>
                    <SolidColorBrush x:Key="CardBorderBrush"         Color="White"/>
                    <SolidColorBrush x:Key="CardHeaderBrush"         Color="White"/>
                    <SolidColorBrush x:Key="CardValueBrush"          Color="White"/>
                    <SolidColorBrush x:Key="CardLabelBrush"          Color="White"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush"      Color="White"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush"      Color="White"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

