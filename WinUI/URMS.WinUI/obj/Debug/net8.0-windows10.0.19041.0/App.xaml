<Application
    x:Class="URMS.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:URMS.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- High-End Material Theme: All visual parameters (colors, brushes, gradients, animation values) -->
                <ResourceDictionary Source="Themes/HighEndMaterialTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="Black"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="Black"/>
                    <SolidColorBrush x:Key="HeaderTitleBrush" Color="White"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="White"/>
                    <SolidColorBrush x:Key="LabelBrush" Color="White"/>
                    <SolidColorBrush x:Key="ValueBrush" Color="White"/>
                    <SolidColorBrush x:Key="CardTitleBrush" Color="White"/>
                    <SolidColorBrush x:Key="HeroCyanBrush" Color="#8FD7FF"/>
                    <SolidColorBrush x:Key="HeroSubBrush" Color="White"/>
                    <SolidColorBrush x:Key="AccentCyanBrush" Color="#8FD7FF"/>
                    <SolidColorBrush x:Key="AccentGreenBrush" Color="#8FFFC9"/>
                    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFD18A"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush" Color="#FFD0F0"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#D8D1FF"/>
                    <SolidColorBrush x:Key="AccentRedBrush" Color="#FFB6C1"/>
                    <SolidColorBrush x:Key="AccentTealBrush" Color="#AAFFF8"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="Black"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="White"/>
                    <SolidColorBrush x:Key="CardHeaderBrush" Color="White"/>
                    <SolidColorBrush x:Key="CardValueBrush" Color="White"/>
                    <SolidColorBrush x:Key="CardLabelBrush" Color="White"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush" Color="White"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="White"/>
                    <SolidColorBrush x:Key="GlobalNoiseBrush" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="AppDepthGradient" Color="Black"/>
                    <SolidColorBrush x:Key="GlassLineBrush" Color="White"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

