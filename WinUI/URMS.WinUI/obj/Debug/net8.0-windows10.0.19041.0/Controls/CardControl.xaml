<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="URMS.WinUI.Controls.CardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
                                     
                                   
                                     
                                       >

  <Grid Background="Transparent">
    <Grid x:ConnectionId='2' x:Name="DeepShadowHost" IsHitTestVisible="False"/>
    <Grid x:ConnectionId='3' x:Name="MidShadowHost" IsHitTestVisible="False"/>
    <Grid x:ConnectionId='4' x:Name="LiftShadowHost" IsHitTestVisible="False"/>

    <Border x:ConnectionId='5' x:Name="HeroAura"
            Margin="-18,-24,-18,-18"
            Background="{ThemeResource MaterialHeroAuraBrush}"
            CornerRadius="28"
            Opacity="0.0"
            IsHitTestVisible="False"/>

    <Border x:ConnectionId='6' x:Name="CardRoot"
            Background="Transparent"
            CornerRadius="18"
            Translation="0,0,12">
      <Grid>
        <Grid x:ConnectionId='7' x:Name="MaterialLayer" IsHitTestVisible="False">
          <Border x:ConnectionId='30' x:Name="HeroBand"
                  Margin="1"
                  Height="66"
                  VerticalAlignment="Top"
                  CornerRadius="17,17,10,10"
                  Background="{ThemeResource MaterialHeroBandBrush}"
                  Opacity="0.0"/>

          <Rectangle x:ConnectionId='31' x:Name="CardBackdropBlur" Margin="1" RadiusX="17" RadiusY="17" Opacity="0.72">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#38141E35" Offset="0"/>
                <GradientStop Color="#2C121A2A" Offset="0.55"/>
                <GradientStop Color="#300C1220" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

            <Border x:ConnectionId='32' x:Name="CardBackground"
              Margin="1"
                  BorderBrush="#3850678D"
                  BorderThickness="1"
                  CornerRadius="17">
            <Border.Background>
              <LinearGradientBrush x:ConnectionId='37' x:Name="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:ConnectionId='38' x:Name="BgStopTop" Color="#FF101826" Offset="0"/>
                <GradientStop x:ConnectionId='39' x:Name="BgStopMid" Color="#FF0C1320" Offset="0.55"/>
                <GradientStop x:ConnectionId='40' x:Name="BgStopBottom" Color="#FF08101A" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <Rectangle x:ConnectionId='33' x:Name="NoiseLayer" Margin="1" RadiusX="17" RadiusY="17" Opacity="0.035" Fill="{ThemeResource GlobalNoiseBrush}"/>

          <Rectangle x:ConnectionId='34' x:Name="SatinReflection" Margin="1" RadiusX="17" RadiusY="17" Opacity="0.105">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3DFFFFFF" Offset="0.0"/>
                <GradientStop Color="#0AFFFFFF" Offset="0.24"/>
                <GradientStop Color="#12B6D8F5" Offset="0.58"/>
                <GradientStop Color="#08FFFFFF" Offset="1.0"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <Border x:ConnectionId='35' x:Name="InnerGlow"
                  Margin="2"
              CornerRadius="16"
                  BorderThickness="6"
                  Opacity="0.18"
                  BorderBrush="#55D5E6F7"/>

          <Border x:ConnectionId='36' x:Name="MaterialFrame"
                  Margin="1"
              CornerRadius="17"
                  BorderThickness="1"
                  BorderBrush="#1218212D"/>
        </Grid>

        <Grid x:ConnectionId='8' x:Name="OpticalLayer" IsHitTestVisible="False">
            <Border x:ConnectionId='25' x:Name="TierRail"
              Width="4"
              Margin="16,22,0,22"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              CornerRadius="2"
              Background="{ThemeResource MaterialHeroBandBrush}"
              Opacity="0.0"/>

          <Border x:ConnectionId='26' x:Name="TopHighlight"
                  Margin="2,2,2,0"
              Height="26"
                  VerticalAlignment="Top"
              CornerRadius="17,17,10,10"
                  Opacity="0.48">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#5EFFFFFF" Offset="0.0"/>
                <GradientStop Color="#15FFFFFF" Offset="0.42"/>
                <GradientStop Color="#38B7D9F4" Offset="0.78"/>
                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <Border x:ConnectionId='27' x:Name="SoftInnerReflection"
                  Margin="2"
              CornerRadius="16"
                  BorderThickness="4"
                  Opacity="0.22"
                  BorderBrush="#7DEAF5FF"/>

          <Border x:ConnectionId='28' x:Name="DeepOuterShadow"
                  Margin="0"
                  CornerRadius="10"
                  BorderThickness="1"
                  Opacity="0.12"
                  BorderBrush="#1C070A0F"/>

          <Rectangle x:ConnectionId='29' x:Name="AmbientFog"
                     Margin="2"
                     RadiusX="16"
                     RadiusY="16"
                     Opacity="0.10">
            <Rectangle.Fill>
              <RadialGradientBrush RadiusX="0.85" RadiusY="0.85">
                <GradientStop Color="#22D2E6F8" Offset="0.0"/>
                <GradientStop Color="#08000000" Offset="0.7"/>
                <GradientStop Color="#00000000" Offset="1.0"/>
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>

        <Grid x:ConnectionId='9' x:Name="ContentLayer" Margin="56,48,56,52">
          <StackPanel x:ConnectionId='15' x:Name="InfoPanel" Spacing="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border x:ConnectionId='19' Grid.Column="0"
                      x:Name="InfoIconHost"
                      Width="34"
                      Height="34"
                      CornerRadius="17"
                      Background="#1C2C4259"
                      BorderBrush="#72A8CDEA"
                      BorderThickness="1">
                <FontIcon x:ConnectionId='24' x:Name="InfoIcon"
                          FontSize="15"
                          Glyph="&#xE946;"
                          Foreground="#ECF6FF"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="2" Spacing="8" Margin="0,2,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:ConnectionId='21' x:Name="TitleTextBlock"
                             Grid.Column="0"
                                                                   
                             FontFamily="{ThemeResource BodyFontFamily}"
                             CharacterSpacing="180"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="#A6B7CBDE"
                             TextTrimming="CharacterEllipsis"/>
                  <Border x:ConnectionId='22' x:Name="TierBadge"
                          Grid.Column="1"
                          Padding="8,4"
                          CornerRadius="10"
                          Opacity="0.0"
                          HorizontalAlignment="Right"
                          Background="#18283A52"
                          BorderBrush="#34607A94"
                          BorderThickness="1">
                    <TextBlock x:ConnectionId='23' x:Name="TierBadgeText"
                               Text="SYSTEM"
                               FontFamily="{ThemeResource MonoFontFamily}"
                               FontSize="8"
                               CharacterSpacing="150"
                               Foreground="#D8EAF8"/>
                  </Border>
                </Grid>
                <Rectangle x:ConnectionId='20' x:Name="TitleDivider" Height="1" HorizontalAlignment="Stretch" Opacity="0.42">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#74CBE8FF" Offset="0"/>
                      <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
              </StackPanel>
            </Grid>

            <TextBlock x:ConnectionId='16' x:Name="MainValueTextBlock"
                                                                 
                       FontFamily="{ThemeResource DisplayFontFamily}"
                       CharacterSpacing="26"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="#FFF1F6FB"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:ConnectionId='17' x:Name="SubInfoTextBlock"
                                                               
                       FontFamily="{ThemeResource BodyFontFamily}"
                       FontSize="12"
                       LineHeight="26"
                       Foreground="#8FA2B7C9"
                       TextWrapping="WrapWholeWords"/>

            <ContentPresenter x:ConnectionId='18' x:Name="InnerContent"/>
          </StackPanel>
        </Grid>

        <Grid x:ConnectionId='10' x:Name="OverlayLayer" IsHitTestVisible="False">
          <Ellipse x:ConnectionId='11' x:Name="ActiveOverlay"
                   Width="420"
                   Height="420"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.0">
            <Ellipse.Fill>
              <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                <GradientStop Color="#16DBF1FF" Offset="0.0"/>
                <GradientStop Color="#0CD6EAF8" Offset="0.42"/>
                <GradientStop Color="#00000000" Offset="1.0"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <Ellipse x:ConnectionId='12' x:Name="BackdropBloom"
                   Width="460"
                   Height="460"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.0">
            <Ellipse.Fill>
              <RadialGradientBrush RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#2ED7E9FB" Offset="0.0"/>
                <GradientStop Color="#08D7E9FB" Offset="0.42"/>
                <GradientStop Color="#00000000" Offset="1.0"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <Rectangle x:ConnectionId='13' x:Name="ReflectionWave"
                     Margin="1"
                     RadiusX="17"
                     RadiusY="17"
                     Opacity="0.0">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,-0.2" EndPoint="1,1.2">
                <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                <GradientStop Color="#14FFFFFF" Offset="0.38"/>
                <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                <GradientStop Color="#0FD4EBFF" Offset="1.0"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <Border x:ConnectionId='14' x:Name="GlowBorder"
                  Margin="0"
              CornerRadius="18"
                  BorderThickness="1.5"
                  BorderBrush="#76A8D4F2"
                  Opacity="0.16"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

