<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:URMS.WinUI.Controls"
    Background="Transparent">

  <Page.Resources>

    <SolidColorBrush x:Key="LabelBrush" Color="#FF00F7FF"/>
    <SolidColorBrush x:Key="ValueBrush" Color="#FF00F7FF"/>
    <SolidColorBrush x:Key="HeroSubBrush" Color="#FF00F7FF"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#FF00F7FF"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource AccentCyanBrush}"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily"      Value="Consolas"/>
      <Setter Property="FontSize"        Value="9"/>
      <Setter Property="FontWeight"      Value="Bold"/>
      <Setter Property="CharacterSpacing" Value="390"/>
      <Setter Property="Foreground"      Value="{ThemeResource CardTitleBrush}"/>
    </Style>

    <!-- カードタイトルコンテナ（::before 左線 + テキスト + ::after 右グラデーション） -->
    <ControlTemplate x:Key="CardTitleCyan">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
        <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#2e00f7ff" Offset="0"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </ControlTemplate>

    <Style x:Key="HudLineStyle" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="0,3,0,6"/>
      <Setter Property="Fill">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3000f7ff" Offset="0.0"/>
            <GradientStop Color="#1800f7ff" Offset="0.4"/>
            <GradientStop Color="Transparent"  Offset="1.0"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Grid Background="Transparent">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
      <StackPanel Spacing="10" Padding="24,20" MaxWidth="1800" HorizontalAlignment="Center">

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
            <TextBlock FontFamily="Consolas" FontSize="20" CharacterSpacing="350" Foreground="{ThemeResource HeroCyanBrush}">
              <Run Text="//" Foreground="#5900f7ff" FontSize="14"/>
              <Run Text=" 統合オペレーション "/>
              <Run Text="//" Foreground="#5900f7ff" FontSize="14"/>
              <Run Text=" DASHBOARD"/>
            </TextBlock>
            <TextBlock Text="UNIFIED RESOURCE MANAGEMENT SYSTEM — SECTOR 7 · NODE ALPHA"
                       FontFamily="Consolas" FontSize="9" CharacterSpacing="278"
                       Foreground="{ThemeResource HeroSubBrush}"/>
          </StackPanel>
          <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="320">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1" Margin="0,0,10,0">
              <TextBlock Text="SESSION" FontFamily="Consolas" FontSize="7" CharacterSpacing="222"
                         Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right"/>
              <TextBlock x:ConnectionId='42' x:Name="TxtSessionId" Text="---" FontFamily="Consolas" FontSize="9" CharacterSpacing="150"
                         Foreground="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Right"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#0f00ff88" BorderBrush="#3300ff88"
                    BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="SYSTEM NOMINAL" FontFamily="Consolas" FontSize="9" CharacterSpacing="30"
                           Foreground="{ThemeResource AccentGreenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
              <Button x:ConnectionId='39' x:Name="BtnWinMin" Content="—" Width="28" Height="24" Padding="0"
                      Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1"
                      Foreground="{ThemeResource AccentCyanBrush}" FontFamily="Consolas" FontSize="13"
                                           />
              <Button x:ConnectionId='40' x:Name="BtnWinMax" Content="□" Width="28" Height="24" Padding="0"
                      Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1"
                      Foreground="{ThemeResource AccentCyanBrush}" FontFamily="Consolas" FontSize="12"
                                           />
              <Button x:ConnectionId='41' x:Name="BtnWinClose" Content="×" Width="28" Height="24" Padding="0"
                      Background="#1fFF3A3A" BorderBrush="#55FF3A3A" BorderThickness="1"
                      Foreground="#FFFF9090" FontFamily="Consolas" FontSize="12"
                                             />
            </StackPanel>
          </Grid>
        </Grid>

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>

          <ctrl:CyberCard x:ConnectionId='27' x:Name="CardSchedule" Grid.Column="0" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='38' Grid.Column="2" x:Name="TxtCardSchedule" Style="{StaticResource CardTitleStyle}" Text="SCHEDULE"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <TextBlock Text="09:30" FontFamily="Consolas" FontSize="18" CharacterSpacing="30"
                         Foreground="{ThemeResource AccentCyanBrush}"/>
              <TextBlock x:ConnectionId='37' x:Name="TxtSchedNext" Text="朝会 (15min)" FontSize="10"
                         Foreground="{ThemeResource LabelBrush}" Margin="0,2,0,0"/>
              <Rectangle Height="1" Margin="0,8" Opacity="0.15" Fill="{ThemeResource CardBorderBrush}"/>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="13:00" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" Width="48"/>
                <TextBlock Grid.Column="1" Text="週次レビュー" FontSize="10" Foreground="{ThemeResource ValueBrush}"/>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="16:00" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" Width="48"/>
                <TextBlock Grid.Column="1" Text="リリース確認" FontSize="10" Foreground="{ThemeResource ValueBrush}"/>
              </Grid>
            </StackPanel>
          </ctrl:CyberCard>

          <ctrl:CyberCard x:ConnectionId='28' x:Name="CardWeather" Grid.Column="1" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='36' Grid.Column="2" x:Name="TxtCardWeather" Style="{StaticResource CardTitleStyle}" Text="WEATHER"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctrl:WeatherAnimation x:ConnectionId='33' x:Name="WxAnim" Grid.Column="0" Condition="sunny" Height="56" Width="56"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2" VerticalAlignment="Top">
                  <TextBlock x:ConnectionId='34' x:Name="TxtWeatherTemp" Text="22°C" FontFamily="Consolas" FontSize="26" CharacterSpacing="8" Foreground="{ThemeResource AccentCyanBrush}"/>
                  <TextBlock x:ConnectionId='35' x:Name="TxtWeatherDesc" Text="Tokyo · Minato" FontSize="9" Foreground="{ThemeResource LabelBrush}"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="体感 "/><Run Text="20°C" Foreground="{ThemeResource ValueBrush}"/></TextBlock>
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="湿度 "/><Run Text="58%" Foreground="{ThemeResource ValueBrush}"/></TextBlock>
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}" Text="晴れ時々曇り"/>
              </StackPanel>
            </StackPanel>
          </ctrl:CyberCard>

          <ctrl:CyberCard x:ConnectionId='29' x:Name="CardTask" Grid.Column="2" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='32' Grid.Column="2" x:Name="TxtCardTask" Style="{StaticResource CardTitleStyle}" Text="TASKS"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="22" Foreground="{ThemeResource AccentGreenBrush}">
                  <Run Text="5"/><Run Text=" / 8" FontSize="13" Foreground="{ThemeResource LabelBrush}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="62%" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource AccentGreenBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
              </Grid>
              <ProgressBar x:ConnectionId='31' x:Name="BarTaskPct" Value="62" Height="5" Margin="0,8,0,0" Foreground="{ThemeResource AccentGreenBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="完了: "/><Run Text="5" Foreground="{ThemeResource AccentGreenBrush}"/></TextBlock>
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="未了: "/><Run Text="3" Foreground="{ThemeResource AccentAmberBrush}"/></TextBlock>
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="優先: "/><Run Text="1" Foreground="{ThemeResource AccentRedBrush}"/></TextBlock>
              </StackPanel>
            </StackPanel>
          </ctrl:CyberCard>

          <ctrl:CyberCard x:ConnectionId='30' x:Name="CardSecurity" Grid.Column="3" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentGreenBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="SECURITY" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource AccentGreenBrush}"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00ff88" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Height="1" Margin="0,4,0,10">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3000ff88" Offset="0.0"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🛡" FontFamily="Segoe UI Emoji" FontSize="26" Foreground="{ThemeResource AccentGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="PROTECTED" FontFamily="Consolas" FontSize="13" CharacterSpacing="20" Foreground="{ThemeResource AccentGreenBrush}"/>
                  <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="脅威: "/><Run Text="0件" Foreground="{ThemeResource AccentGreenBrush}"/></TextBlock>
                  <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="スキャン: "/><Run Text="04:28" Foreground="{ThemeResource ValueBrush}"/></TextBlock>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ctrl:CyberCard>
        </Grid>

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*"/>
            <ColumnDefinition Width="2.25*"/>
            <ColumnDefinition Width="1.05*"/>
          </Grid.ColumnDefinitions>

          <ctrl:CyberCard x:ConnectionId='13' x:Name="CardLauncher" Grid.Column="0" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='26' Grid.Column="2" x:Name="TxtCardLauncher" Style="{StaticResource CardTitleStyle}" Text="QUICK LAUNCH"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="📁 Files" FontSize="10" Padding="6,7" Margin="0,0,3,3" HorizontalAlignment="Stretch" Background="#0a00f7ff" BorderBrush="#2500f7ff" BorderThickness="1" CornerRadius="4" Foreground="{ThemeResource AccentCyanBrush}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="📋 Logs" FontSize="10" Padding="6,7" Margin="3,0,0,3" HorizontalAlignment="Stretch" Background="#0a00ff88" BorderBrush="#2500ff88" BorderThickness="1" CornerRadius="4" Foreground="{ThemeResource AccentGreenBrush}"/>
                <Button Grid.Row="1" Grid.Column="0" Content="⚙ Config" FontSize="10" Padding="6,7" Margin="0,0,3,0" HorizontalAlignment="Stretch" Background="#0ac060ff" BorderBrush="#25c060ff" BorderThickness="1" CornerRadius="4" Foreground="{ThemeResource AccentPurpleBrush}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="📊 Report" FontSize="10" Padding="6,7" Margin="3,0,0,0" HorizontalAlignment="Stretch" Background="#0affb800" BorderBrush="#25ffb800" BorderThickness="1" CornerRadius="4" Foreground="{ThemeResource AccentAmberBrush}"/>
              </Grid>
            </StackPanel>
          </ctrl:CyberCard>

          <ctrl:CyberCard x:ConnectionId='14' x:Name="CardSysmon" Grid.Column="1" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="SYSTEM MONITOR" Style="{StaticResource CardTitleStyle}"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="CPU" FontFamily="Consolas" FontSize="9" CharacterSpacing="60" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  <ctrl:AnalogGauge x:ConnectionId='25' x:Name="GaugeCpu" Value="72" Label="CPU" GaugeColor="#00d4f0" Width="80" Height="70"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="RAM" FontFamily="Consolas" FontSize="9" CharacterSpacing="60" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  <ctrl:AnalogGauge x:ConnectionId='24' x:Name="GaugeRam" Value="58" Label="RAM" GaugeColor="#00e676" Width="80" Height="70"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="GPU" FontFamily="Consolas" FontSize="9" CharacterSpacing="60" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  <ctrl:AnalogGauge x:ConnectionId='23' x:Name="GaugeGpu" Value="45" Label="GPU" GaugeColor="#d080ff" Width="80" Height="70"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="DISK USAGE" FontFamily="Consolas" FontSize="8" CharacterSpacing="60" FontWeight="Bold" Foreground="{ThemeResource CardTitleBrush}" Margin="0,12,0,4"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="C:" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                <ProgressBar x:ConnectionId='21' Grid.Column="1" x:Name="BarDiskC" Value="68" Height="6" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='22' Grid.Column="2" x:Name="TxtDiskC" Text="68%" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="D:" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                <ProgressBar x:ConnectionId='19' Grid.Column="1" x:Name="BarDiskD" Value="42" Height="6" Foreground="{ThemeResource AccentGreenBrush}" Background="{ThemeResource ProgressTrackBrush}" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='20' Grid.Column="2" x:Name="TxtDiskD" Text="42%" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NAS:" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
                <ProgressBar x:ConnectionId='17' Grid.Column="1" x:Name="BarDiskNas" Value="31" Height="6" Foreground="{ThemeResource AccentPurpleBrush}" Background="{ThemeResource ProgressTrackBrush}" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='18' Grid.Column="2" x:Name="TxtDiskNas" Text="31%" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </ctrl:CyberCard>

          <ctrl:CyberCard x:ConnectionId='15' x:Name="CardNetwork" Grid.Column="2" Margin="0">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="NETWORK" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource AccentCyanBrush}"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <TextBlock FontFamily="Consolas" FontSize="24" CharacterSpacing="10" Foreground="{ThemeResource AccentCyanBrush}">
                <Run Text="24"/><Run Text=" hosts" FontSize="11" Foreground="{ThemeResource LabelBrush}"/>
              </TextBlock>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,3,0" Padding="6,5" Background="#0a00f7ff" BorderBrush="#1e00f7ff" BorderThickness="1" CornerRadius="4">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="12ms" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="LATENCY" FontFamily="Consolas" FontSize="7" CharacterSpacing="40" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="3,0,0,0" Padding="6,5" Background="#0a00ff88" BorderBrush="#1e00ff88" BorderThickness="1" CornerRadius="4">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="100%" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="UPTIME" FontFamily="Consolas" FontSize="7" CharacterSpacing="40" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Canvas x:ConnectionId='16' x:Name="NetWaveCanvas" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </ctrl:CyberCard>
        </Grid>

        <Grid Margin="0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid x:ConnectionId='3' x:Name="SubNetwork" Grid.Column="0" Margin="0">
            <Border Background="#AD040914" BorderBrush="#2A00f7ff" BorderThickness="1">
              <Grid>
                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,6">
                  <TextBlock Text="🌐" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center" Foreground="{ThemeResource AccentCyanBrush}"/>
                  <TextBlock Text="NETWORK" FontFamily="Consolas" FontSize="8" CharacterSpacing="40" HorizontalAlignment="Center" Foreground="#8000f7ff"/>
