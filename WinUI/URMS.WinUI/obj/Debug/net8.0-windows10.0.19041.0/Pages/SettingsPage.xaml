<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Page.Resources>
    <Style x:Key="CatButtonStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="#121A2531"/>
      <Setter Property="BorderBrush" Value="#24374A5D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="CatButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource CatButtonStyle}">
      <Setter Property="Background" Value="#263A5168"/>
      <Setter Property="BorderBrush" Value="#4B718BA4"/>
      <Setter Property="Foreground" Value="{ThemeResource ValueBrush}"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Rectangle Opacity="0.012" Fill="{ThemeResource GlobalNoiseBrush}"/>
    <Rectangle Opacity="0.12">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#16385168" Offset="0"/>
          <GradientStop Color="#00000000" Offset="0.45"/>
          <GradientStop Color="#10213145" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:ConnectionId='28' x:Name="BtnBack" Grid.Column="0"                Width="42" Height="42" Padding="0" Background="#18273648" BorderBrush="#2E4E6580" BorderThickness="1" Foreground="{ThemeResource ValueBrush}" CornerRadius="21">&#xE76B;</Button>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="SETTINGS" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" CharacterSpacing="220" Foreground="{ThemeResource HeaderTitleBrush}"/>
          <TextBlock Text="MATERIAL TONE / LUMINANCE REDUCED / DENSITY GUIDED" FontFamily="Consolas" FontSize="9" CharacterSpacing="130" Foreground="{ThemeResource HeaderSubtitleBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="18" BorderBrush="#2B405365" BorderThickness="1" Background="#8A0A121A" Padding="18">
          <StackPanel Spacing="10">
            <Button x:ConnectionId='24' x:Name="BtnCatGeneral" Content="GENERAL" Style="{StaticResource CatButtonActiveStyle}"                     />
            <Button x:ConnectionId='25' x:Name="BtnCatUI" Content="UI" Style="{StaticResource CatButtonStyle}"                />
            <Button x:ConnectionId='26' x:Name="BtnCatSystem" Content="SYSTEM" Style="{StaticResource CatButtonStyle}"                    />
            <Button x:ConnectionId='27' x:Name="BtnCatDeveloper" Content="DEVELOPER" Style="{StaticResource CatButtonStyle}"                       />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Border CornerRadius="22" BorderBrush="#30485E71" BorderThickness="1" Background="#970A1118" Padding="28">
              <Grid>
                <Rectangle Opacity="0.015" Fill="{ThemeResource GlobalNoiseBrush}" RadiusX="22" RadiusY="22"/>
                <StackPanel Spacing="22">
                  <StackPanel x:ConnectionId='3' x:Name="PanelGeneral" Spacing="16">
                    <TextBlock Text="General" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="Theme" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:ConnectionId='20' x:Name="CmbTheme"                                  >
                          <ComboBoxItem x:ConnectionId='21' x:Name="CmbThemeFuturistic" Content="Futuristic"/>
                          <ComboBoxItem x:ConnectionId='22' x:Name="CmbThemeDark" Content="Dark"/>
                          <ComboBoxItem x:ConnectionId='23' x:Name="CmbThemeLight" Content="Light"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Language" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:ConnectionId='19' x:Name="CmbLanguage"                                     >
                          <ComboBoxItem Content="Japanese"/>
                          <ComboBoxItem Content="English"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Version" Foreground="{ThemeResource LabelBrush}"/>
                          <TextBlock x:ConnectionId='18' x:Name="TxtVersion" Text="1.0.0" Foreground="{ThemeResource ValueBrush}" FontSize="18"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Build Date" Foreground="{ThemeResource LabelBrush}"/>
                          <TextBlock x:ConnectionId='17' x:Name="TxtBuildDate" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>

                  <StackPanel x:ConnectionId='4' x:Name="PanelUI" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="UI" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="Accent" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:ConnectionId='16' x:Name="CmbAccentColor"                                        >
                          <ComboBoxItem Content="Cyan" Tag="#7FAECC"/>
                          <ComboBoxItem Content="Green" Tag="#7BB89F"/>
                          <ComboBoxItem Content="Magenta" Tag="#A98AAE"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Target FPS" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:ConnectionId='15' x:Name="CmbTargetFps"                                      >
                          <ComboBoxItem Content="60 fps" Tag="60"/>
                          <ComboBoxItem Content="90 fps" Tag="90"/>
                          <ComboBoxItem Content="120 fps" Tag="120"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <Border Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Animation Intensity" Foreground="{ThemeResource LabelBrush}"/>
                        <Slider x:ConnectionId='13' x:Name="SliderAnimIntensity" Minimum="0" Maximum="2" StepFrequency="0.1" Value="1.0"                                      />
                        <TextBlock x:ConnectionId='14' x:Name="TxtAnimIntensity" Text="1.0x" Foreground="{ThemeResource ValueBrush}" FontSize="18"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel x:ConnectionId='5' x:Name="PanelSystem" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="System" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <ToggleSwitch x:ConnectionId='9' x:Name="TogBootAnim" IsOn="True"                             Header="Boot animation"/>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Launch" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:ConnectionId='12' x:Name="TxtBootLaunch" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/></StackPanel></Border>
                      <Border Grid.Column="1" Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Dashboard" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:ConnectionId='11' x:Name="TxtBootDash" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/></StackPanel></Border>
                      <Border Grid.Column="2" Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Complete" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:ConnectionId='10' x:Name="TxtBootComplete" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/></StackPanel></Border>
                    </Grid>
                  </StackPanel>

                  <StackPanel x:ConnectionId='6' x:Name="PanelDeveloper" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Developer" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <ToggleSwitch x:ConnectionId='7' x:Name="TogDebugLog" IsOn="False"                             Header="Debug log"/>
                    <Border Background="#12243246" BorderBrush="#27455D72" BorderThickness="1" CornerRadius="14" Padding="16">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Settings Path" Foreground="{ThemeResource LabelBrush}"/>
                        <TextBlock x:ConnectionId='8' x:Name="TxtSettingsPath" Text="-" Foreground="{ThemeResource ValueBrush}" TextWrapping="WrapWholeWords"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Margin="0,24,0,0" Padding="14,12" CornerRadius="14" Background="#9A0C141C" BorderThickness="1" BorderBrush="#2A425566">
        <TextBlock x:ConnectionId='2' x:Name="TxtApplyStatus" Text="Idle" Foreground="{ThemeResource ValueBrush}"/>
      </Border>
    </Grid>
  </Grid>
</Page>

