<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.BootHudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    Opacity="1">

  <Grid x:ConnectionId='2' x:Name="BootRoot">
    <!-- 不透明背景 — Dashboard が透けないよう Alpha=FF 必須 -->
    <Grid.Background>
      <RadialGradientBrush Center="0.5,0.45" RadiusX="0.9" RadiusY="0.8">
        <GradientStop Color="#FF0A1721" Offset="0"/>
        <GradientStop Color="#FF060B10" Offset="0.48"/>
        <GradientStop Color="#FF05080A" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>

    <!-- ── 微細ノイズオーバーレイ (Opacity 0.04) ── -->
    <Rectangle x:ConnectionId='3' x:Name="NoiseOverlay"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsHitTestVisible="False" Opacity="0.04">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF3A6080" Offset="0.0"/>
          <GradientStop Color="#FF0A1520" Offset="0.25"/>
          <GradientStop Color="#FF1A3040" Offset="0.5"/>
          <GradientStop Color="#FF0A1520" Offset="0.75"/>
          <GradientStop Color="#FF3A6080" Offset="1.0"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- ── パーティクルキャンバス ── -->
    <Canvas x:ConnectionId='4' x:Name="BootParticleCanvas" IsHitTestVisible="False"/>

    <!-- ── コンテンツパネル（フェード・スケール対象） ── -->
    <StackPanel x:ConnectionId='5' x:Name="BootContentPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Opacity="0">

      <StackPanel.RenderTransform>
        <ScaleTransform x:ConnectionId='6' x:Name="ContentScale" ScaleX="1.0" ScaleY="1.0"
                        CenterX="0" CenterY="0"/>
      </StackPanel.RenderTransform>

      <!-- ロゴ枠 -->
      <Border Width="184" Height="184" CornerRadius="6"
              BorderBrush="#3300E0FF" BorderThickness="1"
              Background="#140B1218" HorizontalAlignment="Center">
        <Image x:ConnectionId='8' x:Name="UrmsLogo" Stretch="Uniform" Margin="14" Opacity="0">
          <Image.Source>
            <BitmapImage UriSource="ms-appx:///Assets/images/urms-icon.png"
                         DecodePixelWidth="512" DecodePixelHeight="512"/>
          </Image.Source>
        </Image>
      </Border>

      <TextBlock Text="UNIFIED RUNNER MANAGEMENT SYSTEM"
                 FontFamily="Consolas"
                 FontSize="16" FontWeight="Bold"
                 CharacterSpacing="120"
                 Foreground="#C8E8F4"
                 HorizontalAlignment="Center"/>

      <TextBlock x:ConnectionId='7' x:Name="BootStatusText"
                 Text="INITIALIZING"
                 FontFamily="Consolas"
                 FontSize="13" FontWeight="SemiBold"
                 CharacterSpacing="80"
                 Foreground="#9AD9EA"
                 HorizontalAlignment="Center"/>

      <TextBlock Text="v5.0.0"
                 FontFamily="Consolas"
                 FontSize="12"
                 Foreground="#88C3D3"
                 HorizontalAlignment="Center"/>

    </StackPanel>
  </Grid>
</Page>

