<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="URMS.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:URMS.WinUI"
    Title="URMS">

  <Grid Background="{ThemeResource AppBackgroundBrush}">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Q" Modifiers="Control" Invoked="OnKeyboardAccelerator_Q"/>
      <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnKeyboardAccelerator_E"/>
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnKeyboardAccelerator_W"/>
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ─── 背景 z:0: 星空 ─── -->
    <Canvas x:Name="BgStarsCanvas"  Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>

    <!-- ─── 背景 z:1: Nebula 放射グラデーション (nebulapulse 12s) ─── -->
    <Grid x:Name="NebulaGrid" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
      <!-- レイヤー 1: 左上ブルー rgba(0,100,180,.11) -->
      <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.15,0.3" GradientOrigin="0.15,0.3" RadiusX="0.55" RadiusY="0.4">
            <GradientStop Color="#1c0064b4" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- レイヤー 2: 右下パープル rgba(140,0,220,.09) -->
      <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.85,0.7" GradientOrigin="0.85,0.7" RadiusX="0.5" RadiusY="0.35">
            <GradientStop Color="#168c00dc" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- レイヤー 3: 中央上ティール rgba(0,200,160,.07) -->
      <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.5,0.08" GradientOrigin="0.5,0.08" RadiusX="0.45" RadiusY="0.3">
            <GradientStop Color="#1200c8a0" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- レイヤー 4: 右下ブルー rgba(0,150,255,.08) -->
      <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.7,0.9" GradientOrigin="0.7,0.9" RadiusX="0.5" RadiusY="0.25">
            <GradientStop Color="#140096ff" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- ─── 背景 z:2: グリッドパターン ─── -->
    <Canvas x:Name="BgGridCanvas"   Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>

    <!-- ─── 背景 z:2: パースペクティブグリッド ─── -->
    <Canvas x:Name="BgPerspCanvas"  Grid.Row="1" IsHitTestVisible="False"/>

    <!-- ─── 背景 z:3: マトリクス文字 ─── -->
    <Canvas x:Name="BgMatrixCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.14"/>

    <!-- ─── HUD 4 コーナーブラケット ─── -->
    <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
      <!-- 左上 -->
      <Canvas Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
        <Line X1="0" Y1="70" X2="0" Y2="0" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Line X1="0" Y1="0" X2="70" Y2="0" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="7" Height="7">
          <Ellipse.Fill><SolidColorBrush Color="#00f7ff" Opacity="0.8"/></Ellipse.Fill>
        </Ellipse>
      </Canvas>
      <!-- 右上 -->
      <Canvas Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
        <Line X1="70" Y1="70" X2="70" Y2="0" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Line X1="0"  Y1="0"  X2="70" Y2="0" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Ellipse Canvas.Left="66" Canvas.Top="-3" Width="7" Height="7">
          <Ellipse.Fill><SolidColorBrush Color="#00f7ff" Opacity="0.8"/></Ellipse.Fill>
        </Ellipse>
      </Canvas>
      <!-- 左下 -->
      <Canvas Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
        <Line X1="0" Y1="0" X2="0"  Y2="70" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Line X1="0" Y1="70" X2="70" Y2="70" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Ellipse Canvas.Left="-3" Canvas.Top="66" Width="7" Height="7">
          <Ellipse.Fill><SolidColorBrush Color="#00f7ff" Opacity="0.8"/></Ellipse.Fill>
        </Ellipse>
      </Canvas>
      <!-- 右下 -->
      <Canvas Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
        <Line X1="70" Y1="0" X2="70" Y2="70" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Line X1="0"  Y1="70" X2="70" Y2="70" Stroke="#4d00f7ff" StrokeThickness="2"/>
        <Ellipse Canvas.Left="66" Canvas.Top="66" Width="7" Height="7">
          <Ellipse.Fill><SolidColorBrush Color="#00f7ff" Opacity="0.8"/></Ellipse.Fill>
        </Ellipse>
      </Canvas>
    </Grid>

    <!-- ─── ヘッダー ─── -->
    <Grid Grid.Row="0" Background="{ThemeResource HeaderBackgroundBrush}"
          DoubleTapped="OnHeaderDoubleTapped">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- ロゴ -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" Margin="24,0,16,0">
        <TextBlock Text="URMS" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                   CharacterSpacing="278" Foreground="{ThemeResource HeaderTitleBrush}"/>
        <TextBlock Text="UNIFIED RESOURCE MANAGEMENT"
                   FontFamily="Consolas" FontSize="9" CharacterSpacing="333"
                   Foreground="{ThemeResource HeaderSubtitleBrush}"/>
      </StackPanel>

      <!-- スペクトラムバー（flex:1） -->
      <StackPanel x:Name="SpectrumPanel" Grid.Column="1" Orientation="Horizontal"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="24"/>

      <!-- ステータス -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,16,0">
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource AccentGreenBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtStatus" Text="SYS_NOMINAL" FontFamily="Consolas" FontSize="10"
                   CharacterSpacing="120" Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- レーダー SVG -->
      <Canvas x:Name="RadarCanvas" Grid.Column="3" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,16,0">
        <Ellipse Canvas.Left="1"  Canvas.Top="1"  Width="38" Height="38" Stroke="#2600f7ff" StrokeThickness="1"/>
        <Ellipse Canvas.Left="8"  Canvas.Top="8"  Width="24" Height="24" Stroke="#1a00f7ff" StrokeThickness="1"/>
        <Ellipse Canvas.Left="14" Canvas.Top="14" Width="12" Height="12" Stroke="#1000f7ff" StrokeThickness="1"/>
        <Line X1="20" Y1="2"  X2="20" Y2="38" Stroke="#0e00f7ff" StrokeThickness="1"/>
        <Line X1="2"  Y1="20" X2="38" Y2="20" Stroke="#0e00f7ff" StrokeThickness="1"/>
        <Path Data="M20,20 L38,20 A18,18 0 0 0 35,11 Z" Fill="#1a00f7ff">
          <Path.RenderTransform>
            <RotateTransform x:Name="RadarRotate" CenterX="20" CenterY="20"/>
          </Path.RenderTransform>
        </Path>
        <Ellipse x:Name="RadarBlip0" Canvas.Left="24" Canvas.Top="12" Width="3"   Height="3"   Fill="#CC00f7ff" Opacity="0"/>
        <Ellipse x:Name="RadarBlip1" Canvas.Left="11" Canvas.Top="25" Width="2"   Height="2"   Fill="#9900ff88" Opacity="0"/>
        <Ellipse                     Canvas.Left="29" Canvas.Top="27" Width="2.5" Height="2.5" Fill="#7f00f7ff" Opacity="0.5"/>
      </Canvas>

      <!-- セパレーター -->
      <Rectangle Grid.Column="4" Width="1" Height="28" Fill="#1a00f7ff" VerticalAlignment="Center" Margin="0,0,16,0"/>

      <!-- 時計 -->
      <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="0" Margin="0,0,16,0">
        <TextBlock x:Name="TxtClock" Text="--:--:--" FontFamily="Consolas" FontSize="22"
                   CharacterSpacing="136" Foreground="{ThemeResource AccentCyanBrush}" TextAlignment="Right"/>
        <TextBlock x:Name="TxtDate" Text="---" FontFamily="Consolas" FontSize="11"
                   CharacterSpacing="250" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right"/>
      </StackPanel>

      <!-- 右上: ウィンドウ制御 + 設定 -->
      <Grid Grid.Column="6" VerticalAlignment="Center" Margin="0,0,24,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,0,0,4">
          <Button x:Name="BtnTopWinMin" Content="—" Width="34" Height="24" Padding="0"
                  Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1"
                  Foreground="{ThemeResource AccentCyanBrush}" FontFamily="Consolas" FontSize="13"
                  Click="OnWinMinClick"/>
          <Button x:Name="BtnTopWinMax" Content="□" Width="34" Height="24" Padding="0"
                  Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1"
                  Foreground="{ThemeResource AccentCyanBrush}" FontFamily="Consolas" FontSize="12"
                  Click="OnWinMaxClick"/>
          <Button x:Name="BtnTopWinClose" Content="×" Width="34" Height="24" Padding="0"
                  Background="#1fFF3A3A" BorderBrush="#55FF3A3A" BorderThickness="1"
                  Foreground="#FFFF9090" FontFamily="Consolas" FontSize="12"
                  Click="OnWinCloseClick"/>
        </StackPanel>

        <Border Grid.Row="1" Width="38" Height="38" HorizontalAlignment="Right"
          Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1" CornerRadius="8">
          <TextBlock Text="⚙" FontSize="16" Foreground="#FF00F7FF"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>

      <!-- 下部グローライン -->
      <Rectangle Grid.Column="0" Grid.ColumnSpan="7" VerticalAlignment="Bottom" Height="1"
                 HorizontalAlignment="Stretch" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent" Offset="0.0"/>
            <GradientStop Color="#3000f7ff"   Offset="0.3"/>
            <GradientStop Color="#3000f7ff"   Offset="0.7"/>
            <GradientStop Color="Transparent" Offset="1.0"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- ─── コンテンツエリア ─── -->
    <Grid Grid.Row="1">
      <Frame x:Name="ContentFrame"/>
    </Grid>

    <!-- ─── スキャンライン (全画面, z-top) ─── -->
    <Rectangle x:Name="ScanLine" Grid.Row="0" Grid.RowSpan="2"
               HorizontalAlignment="Stretch" Height="3"
               VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.6">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="Transparent" Offset="0.0"/>
          <GradientStop Color="#7f00f7ff"   Offset="0.4"/>
          <GradientStop Color="#e500f7ff"   Offset="0.5"/>
          <GradientStop Color="#7f00f7ff"   Offset="0.6"/>
          <GradientStop Color="Transparent" Offset="1.0"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
      <Rectangle.RenderTransform>
        <TranslateTransform x:Name="ScanLineTranslate"/>
      </Rectangle.RenderTransform>
    </Rectangle>

  </Grid>
</Window>
