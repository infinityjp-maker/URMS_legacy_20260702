<Application
    x:Class="URMS.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:URMS.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- URMS Cyberpunk Theme Resources -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Backgrounds -->
                    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#090F1A"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#090F1A"/>
                    <!-- Text -->
                    <SolidColorBrush x:Key="HeaderTitleBrush"        Color="#BFD3EA"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush"     Color="#6E809A"/>
                    <SolidColorBrush x:Key="LabelBrush"              Color="#6E8097"/>
                    <SolidColorBrush x:Key="ValueBrush"              Color="#C7D2E0"/>
                    <SolidColorBrush x:Key="CardTitleBrush"          Color="#90A8C6"/>
                    <!-- Hero -->
                    <SolidColorBrush x:Key="HeroCyanBrush"           Color="#78B9D6"/>
                    <SolidColorBrush x:Key="HeroSubBrush"            Color="#7B8FA9"/>
                    <!-- Accents -->
                    <SolidColorBrush x:Key="AccentCyanBrush"         Color="#4DAFD4"/>
                    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#5EBB98"/>
                    <SolidColorBrush x:Key="AccentAmberBrush"        Color="#C89A58"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush"      Color="#B37AA8"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush"       Color="#837FBD"/>
                    <SolidColorBrush x:Key="AccentRedBrush"          Color="#C06C7D"/>
                    <SolidColorBrush x:Key="AccentTealBrush"         Color="#59A7A3"/>
                    <!-- Cards / UI Elements -->
                    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="#0B1019"/>
                    <SolidColorBrush x:Key="CardBorderBrush"         Color="#25384F"/>
                    <SolidColorBrush x:Key="CardHeaderBrush"         Color="#111929"/>
                    <SolidColorBrush x:Key="CardValueBrush"          Color="#CFE4F8"/>
                    <SolidColorBrush x:Key="CardLabelBrush"          Color="#7388A8"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush"      Color="#9DB3CF"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush"      Color="#1A2434"/>
                    <SolidColorBrush x:Key="GlobalNoiseBrush"       Color="#03FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#090F1A"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#090F1A"/>
                    <SolidColorBrush x:Key="HeaderTitleBrush"        Color="#BFD3EA"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush"     Color="#6E809A"/>
                    <SolidColorBrush x:Key="LabelBrush"              Color="#6E8097"/>
                    <SolidColorBrush x:Key="ValueBrush"              Color="#C7D2E0"/>
                    <SolidColorBrush x:Key="CardTitleBrush"          Color="#90A8C6"/>
                    <SolidColorBrush x:Key="HeroCyanBrush"           Color="#78B9D6"/>
                    <SolidColorBrush x:Key="HeroSubBrush"            Color="#7B8FA9"/>
                    <SolidColorBrush x:Key="AccentCyanBrush"         Color="#4DAFD4"/>
                    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#5EBB98"/>
                    <SolidColorBrush x:Key="AccentAmberBrush"        Color="#C89A58"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush"      Color="#B37AA8"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush"       Color="#837FBD"/>
                    <SolidColorBrush x:Key="AccentRedBrush"          Color="#C06C7D"/>
                    <SolidColorBrush x:Key="AccentTealBrush"         Color="#59A7A3"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="#0B1019"/>
                    <SolidColorBrush x:Key="CardBorderBrush"         Color="#25384F"/>
                    <SolidColorBrush x:Key="CardHeaderBrush"         Color="#111929"/>
                    <SolidColorBrush x:Key="CardValueBrush"          Color="#CFE4F8"/>
                    <SolidColorBrush x:Key="CardLabelBrush"          Color="#7388A8"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush"      Color="#9DB3CF"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush"      Color="#1A2434"/>
                    <SolidColorBrush x:Key="GlobalNoiseBrush"       Color="#03FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="Black"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="Black"/>
                    <SolidColorBrush x:Key="HeaderTitleBrush"        Color="White"/>
                    <SolidColorBrush x:Key="HeaderSubtitleBrush"     Color="White"/>
                    <SolidColorBrush x:Key="LabelBrush"              Color="White"/>
                    <SolidColorBrush x:Key="ValueBrush"              Color="White"/>
                    <SolidColorBrush x:Key="CardTitleBrush"          Color="White"/>
                    <SolidColorBrush x:Key="HeroCyanBrush"           Color="#00f7ff"/>
                    <SolidColorBrush x:Key="HeroSubBrush"            Color="White"/>
                    <SolidColorBrush x:Key="AccentCyanBrush"         Color="#00f7ff"/>
                    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#00ff88"/>
                    <SolidColorBrush x:Key="AccentAmberBrush"        Color="#ffb300"/>
                    <SolidColorBrush x:Key="AccentMagentaBrush"      Color="#ff00cc"/>
                    <SolidColorBrush x:Key="AccentPurpleBrush"       Color="#b000ff"/>
                    <SolidColorBrush x:Key="AccentRedBrush"          Color="#ff3333"/>
                    <SolidColorBrush x:Key="AccentTealBrush"         Color="#00e5cc"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="Black"/>
                    <SolidColorBrush x:Key="CardBorderBrush"         Color="White"/>
                    <SolidColorBrush x:Key="CardHeaderBrush"         Color="White"/>
                    <SolidColorBrush x:Key="CardValueBrush"          Color="White"/>
                    <SolidColorBrush x:Key="CardLabelBrush"          Color="White"/>
                    <SolidColorBrush x:Key="SectionHeaderBrush"      Color="White"/>
                    <SolidColorBrush x:Key="ProgressTrackBrush"      Color="White"/>
                    <SolidColorBrush x:Key="GlobalNoiseBrush"        Color="#00FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
