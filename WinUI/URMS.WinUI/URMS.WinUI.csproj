<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <UseRidGraph>true</UseRidGraph>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\images\urms.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\images\urms.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\images\urms-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\images\urms_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Page Remove="MainWindow_minimal.xaml" />
    <None Include="MainWindow_minimal.xaml" />
    <Page Remove="Pages\DashboardPage_backup.xaml" />
    <None Include="Pages\DashboardPage_backup.xaml" />
    <Compile Remove="MainWindow_simple.xaml.cs" />
    <None Include="MainWindow_simple.xaml.cs" />
    <!-- Views/Cards/ (旧UI残骸) 除外 -->
    <Page Remove="Views/**/*.xaml" />
    <Compile Remove="Views/**/*.cs" />
    <None Remove="Views/**/*.*" />
  </ItemGroup>
</Project>
