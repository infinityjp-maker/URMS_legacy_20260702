<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.WorkflowCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <StackPanel Spacing="10">
    <TextBlock Text="WORKFLOW" FontFamily="Consolas" FontSize="9" CharacterSpacing="120" Foreground="#FF00E0FF"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="10">
      <StackPanel HorizontalAlignment="Center" Width="90">
        <Ellipse x:Name="Dot0" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Txt0" Text="Init" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Width="90">
        <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Txt1" Text="Validate" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Width="90">
        <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Txt2" Text="Build" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Width="90">
        <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Txt3" Text="Deploy" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Width="90">
        <Ellipse x:Name="Dot4" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Txt4" Text="Sync" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Width="90">
        <Ellipse x:Name="Dot5" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Txt5" Text="Done" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
