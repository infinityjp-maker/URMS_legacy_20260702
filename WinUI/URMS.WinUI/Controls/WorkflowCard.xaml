<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.WorkflowCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="0">
      <!-- Commit -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoCommit" Grid.Row="0" Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#FF00E0FF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotCommit" Grid.Row="1" Width="12" Height="12" Fill="#FF00E0FF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtCommit" Grid.Row="2" Text="Commit" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#FF00E0FF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaCommit" Grid.Row="3" Text="OK 12s 5" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" Text="→" FontFamily="Consolas" FontSize="10" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
      
      <!-- Build -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoBuild" Grid.Row="0" Glyph="&#xE956;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotBuild" Grid.Row="1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtBuild" Grid.Row="2" Text="Build" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#66FFFFFF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaBuild" Grid.Row="3" Text="OK 31s 1" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" Text="→" FontFamily="Consolas" FontSize="10" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
      
      <!-- Test -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoTest" Grid.Row="0" Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotTest" Grid.Row="1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtTest" Grid.Row="2" Text="Test" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#66FFFFFF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaTest" Grid.Row="3" Text="OK 54s 42" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" Text="→" FontFamily="Consolas" FontSize="10" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
      
      <!-- CI -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoCI" Grid.Row="0" Glyph="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotCI" Grid.Row="1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtCI" Grid.Row="2" Text="CI" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#66FFFFFF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaCI" Grid.Row="3" Text="RUN 19s 8" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" Text="→" FontFamily="Consolas" FontSize="10" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
      
      <!-- CD -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoCD" Grid.Row="0" Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotCD" Grid.Row="1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtCD" Grid.Row="2" Text="CD" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#66FFFFFF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaCD" Grid.Row="3" Text="WAIT 0s 0" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" Text="→" FontFamily="Consolas" FontSize="10" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
      
      <!-- Deploy -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoDeploy" Grid.Row="0" Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotDeploy" Grid.Row="1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtDeploy" Grid.Row="2" Text="Deploy" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#66FFFFFF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaDeploy" Grid.Row="3" Text="WAIT 0s 0" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" Text="→" FontFamily="Consolas" FontSize="10" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
      
      <!-- PR -->
      <Grid HorizontalAlignment="Center" MinWidth="72">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon x:Name="IcoPR" Grid.Row="0" Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" Foreground="#66FFFFFF" Margin="0,0,0,2"/>
        <Ellipse x:Name="DotPR" Grid.Row="1" Width="12" Height="12" Fill="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="TxtPR" Grid.Row="2" Text="PR" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="#66FFFFFF" CharacterSpacing="30"/>
        <TextBlock x:Name="TxtMetaPR" Grid.Row="3" Text="WAIT 0s 0" FontFamily="Consolas" FontSize="6" HorizontalAlignment="Center" Foreground="#99FFFFFF"/>
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
