<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.HeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid Height="72">
    <Border Background="Transparent" CornerRadius="0" Translation="0,0,16">
      <Border.Shadow>
        <ThemeShadow/>
      </Border.Shadow>
      <Grid>
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0A0F1A" Offset="0"/>
            <GradientStop Color="#FF0F1A2A" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0" Spacing="12">
          <Image Width="42" Height="42" Stretch="Uniform" Source="ms-appx:///Assets/images/urms_logo_hd_96dpi.png"/>
          <TextBlock Text="Unified Resource Management System (URMS)"
                     VerticalAlignment="Center"
                     FontFamily="Consolas"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="#FFB9EFFF"
                     CharacterSpacing="40"/>
        </StackPanel>

        <StackPanel x:Name="SpectrumPanel" Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="24" Margin="0,0,0,6"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,12,0">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF00E0FF" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtStatus" Text="SYS_NOMINAL" FontFamily="Consolas" FontSize="10"
                     CharacterSpacing="120" Foreground="#FF8FC8D8" VerticalAlignment="Center"/>
        </StackPanel>

        <Canvas Grid.Column="3" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse Canvas.Left="1" Canvas.Top="1" Width="34" Height="34" Stroke="#2600E0FF" StrokeThickness="1"/>
          <Path Data="M18,18 L35,18 A17,17 0 0 0 32,10 Z" Fill="#1A00E0FF">
            <Path.RenderTransform>
              <RotateTransform x:Name="RadarRotate" CenterX="18" CenterY="18"/>
            </Path.RenderTransform>
          </Path>
          <Ellipse x:Name="RadarBlip0" Canvas.Left="22" Canvas.Top="10" Width="3" Height="3" Fill="#CC00E0FF" Opacity="0"/>
          <Ellipse x:Name="RadarBlip1" Canvas.Left="11" Canvas.Top="23" Width="2.5" Height="2.5" Fill="#9900E0FF" Opacity="0"/>
        </Canvas>

        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="0" Margin="0,0,12,0">
          <TextBlock x:Name="TxtClock" Text="--:--:--" FontFamily="Consolas" FontSize="20" Foreground="#FF00E0FF"/>
          <TextBlock x:Name="TxtDate" Text="---" FontFamily="Consolas" FontSize="10" Foreground="#FF8FC8D8"/>
        </StackPanel>

        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" Spacing="8">
          <Grid>
            <Rectangle x:Name="SettingsGlow" RadiusX="8" RadiusY="8" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="SettingsButton" Width="40" Height="40"
                    Background="#660A0F1A" BorderBrush="#66112233" BorderThickness="1"
                    PointerEntered="OnSettingsPointerEntered" PointerExited="OnSettingsPointerExited"
                    Click="OnSettingsClicked">
              <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>

          <Grid>
            <Rectangle x:Name="CloseGlow" RadiusX="8" RadiusY="8" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="CloseButton" Width="40" Height="40"
                    Background="#660A0F1A" BorderBrush="#66112233" BorderThickness="1"
                    PointerEntered="OnClosePointerEntered" PointerExited="OnClosePointerExited"
                    Click="OnCloseClicked">
              <FontIcon Glyph="&#xE8BB;" FontSize="20" Foreground="#FFFFA3A3"/>
            </Button>
          </Grid>
        </StackPanel>

        <Rectangle VerticalAlignment="Bottom" Height="1" Fill="#5900E0FF"/>
        <Rectangle VerticalAlignment="Bottom" Height="4" Margin="0,1,0,0" IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#40000000" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </Border>
  </Grid>
</UserControl>
