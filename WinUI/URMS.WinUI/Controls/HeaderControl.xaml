<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.HeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid Height="72">
    <Border Background="Transparent" CornerRadius="0" Translation="0,0,16">
      <Border.Shadow>
        <ThemeShadow/>
      </Border.Shadow>
      <Grid>
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0A0F18" Offset="0"/>
            <GradientStop Color="#FF0D121C" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
         <Image Grid.Column="0" Width="48" Height="48" Margin="16,0,16,0" VerticalAlignment="Center"
           Stretch="Uniform" Source="ms-appx:///Assets/images/urms_logo.png"/>

        <!-- Title + Subtitle + Spectrum -->
        <Grid Grid.Column="1" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Spacing="0" Margin="8,0,0,0">
            <TextBlock Text="URMS" FontFamily="Consolas" FontSize="23" FontWeight="ExtraBold"
                       CharacterSpacing="280" Foreground="#FFB9EFFF"/>
            <TextBlock Text="Unified Resource Management System"
                       FontFamily="Consolas" FontSize="11"
                       CharacterSpacing="100" Foreground="#FF8899BB" Margin="0,-2,0,0"/>
          </StackPanel>
          <StackPanel x:Name="SpectrumPanel" Orientation="Horizontal"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="16" Margin="0,0,0,2"/>
        </Grid>

        <!-- Status + Radar -->
        <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" Spacing="0" Margin="0,0,24,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF00E0FF" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Text="SCAN_DONE" FontFamily="Consolas" FontSize="10"
                       CharacterSpacing="80" Foreground="#FF00E0FF" VerticalAlignment="Center"/>
          </StackPanel>
          <Canvas Width="32" Height="32" VerticalAlignment="Center" Margin="0,2,0,0">
            <Ellipse Canvas.Left="0" Canvas.Top="0" Width="32" Height="32" Stroke="#2600E0FF" StrokeThickness="1"/>
            <Path Data="M16,16 L30,16 A16,16 0 0 0 28,10 Z" Fill="#1A00E0FF">
              <Path.RenderTransform>
                <RotateTransform x:Name="RadarRotate" CenterX="16" CenterY="16"/>
              </Path.RenderTransform>
            </Path>
            <Ellipse x:Name="RadarBlip0" Canvas.Left="20" Canvas.Top="9" Width="3" Height="3" Fill="#CC00E0FF" Opacity="0"/>
            <Ellipse x:Name="RadarBlip1" Canvas.Left="9" Canvas.Top="21" Width="2.5" Height="2.5" Fill="#9900E0FF" Opacity="0"/>
          </Canvas>
        </StackPanel>

        <!-- Date + Clock -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="24" Margin="0,0,24,0" HorizontalAlignment="Right">
          <TextBlock x:Name="TxtClock" Text="HH:mm" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#FF00E0FF" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtDate" Text="yyyy/MM/dd (DDD)" FontFamily="Consolas" FontSize="10" Foreground="#FF00E0FF" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Window Control Buttons -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="24">
          <Grid>
            <Rectangle x:Name="MinimizeGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="MinimizeButton" Width="32" Height="32"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    CornerRadius="4"
                    PointerEntered="OnMinimizePointerEntered" PointerExited="OnMinimizePointerExited"
                    Click="OnMinimizeClicked">
              <FontIcon Glyph="&#xE921;" FontSize="18" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>
          <Grid>
            <Rectangle x:Name="MaximizeGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="MaximizeButton" Width="32" Height="32"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    CornerRadius="4"
                    PointerEntered="OnMaximizePointerEntered" PointerExited="OnMaximizePointerExited"
                    Click="OnMaximizeClicked">
              <FontIcon Glyph="&#xE922;" FontSize="18" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>
          <Grid>
            <Rectangle x:Name="RestoreGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="RestoreButton" Width="32" Height="32"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    CornerRadius="4"
                    PointerEntered="OnRestorePointerEntered" PointerExited="OnRestorePointerExited"
                    Click="OnRestoreClicked">
              <FontIcon Glyph="&#xE923;" FontSize="18" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>
          <Grid>
            <Rectangle x:Name="CloseGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="CloseButton" Width="32" Height="32"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    CornerRadius="4"
                    PointerEntered="OnClosePointerEntered" PointerExited="OnClosePointerExited"
                    Click="OnCloseClicked">
              <FontIcon Glyph="&#xE8BB;" FontSize="18" Foreground="#FFFFA3A3"/>
            </Button>
          </Grid>
        </StackPanel>

        <Rectangle VerticalAlignment="Bottom" Height="2" Fill="#B200E8FF"/>
        <Rectangle VerticalAlignment="Bottom" Height="6" Margin="0,2,0,0" IsHitTestVisible="False" Opacity="0.15">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#6600E8FF" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </Border>
  </Grid>
</UserControl>
