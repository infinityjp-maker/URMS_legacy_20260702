<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.HeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid Height="72">
    <Border Background="Transparent" CornerRadius="0" Translation="0,0,16">
      <Border.Shadow>
        <ThemeShadow/>
      </Border.Shadow>
      <Grid>
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0A0F1A" Offset="0"/>
            <GradientStop Color="#FF0F1A2A" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Width="48" Height="48" Margin="16,0,12,0" VerticalAlignment="Center"
               Stretch="Uniform" Source="ms-appx:///Assets/images/urms_logo_hd_96dpi.png"/>

        <Grid Grid.Column="1" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="URMS" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                       CharacterSpacing="280" Foreground="#FFB9EFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Unified Resource Management System"
                       FontFamily="Consolas" FontSize="10"
                       CharacterSpacing="100" Foreground="#FFB9EFFF" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SpectrumPanel" Orientation="Horizontal"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="18" Margin="0,0,0,2"/>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,12,0">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF00E0FF" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtStatus" Text="SYS_NOMINAL" FontFamily="Consolas" FontSize="10"
                     CharacterSpacing="120" Foreground="#FF00E0FF" VerticalAlignment="Center"/>
        </StackPanel>

        <Canvas Grid.Column="3" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse Canvas.Left="1" Canvas.Top="1" Width="34" Height="34" Stroke="#2600E0FF" StrokeThickness="1"/>
          <Path Data="M18,18 L35,18 A17,17 0 0 0 32,10 Z" Fill="#1A00E0FF">
            <Path.RenderTransform>
              <RotateTransform x:Name="RadarRotate" CenterX="18" CenterY="18"/>
            </Path.RenderTransform>
          </Path>
          <Ellipse x:Name="RadarBlip0" Canvas.Left="22" Canvas.Top="10" Width="3" Height="3" Fill="#CC00E0FF" Opacity="0"/>
          <Ellipse x:Name="RadarBlip1" Canvas.Left="11" Canvas.Top="23" Width="2.5" Height="2.5" Fill="#9900E0FF" Opacity="0"/>
        </Canvas>

        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1" Margin="0,0,14,0">
          <TextBlock x:Name="TxtClock" Text="--:--:--" FontFamily="Consolas" FontSize="18" Foreground="#FF00E0FF"/>
          <TextBlock x:Name="TxtDate" Text="----/--/-- (---)" FontFamily="Consolas" FontSize="10" Foreground="#FF00E0FF"/>
        </StackPanel>

        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="6">
          <Grid>
            <Rectangle x:Name="MinimizeGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="MinimizeButton" Width="36" Height="36"
                    Background="#660A0F1A" BorderBrush="#66112233" BorderThickness="1"
                    CornerRadius="4"
                    PointerEntered="OnMinimizePointerEntered" PointerExited="OnMinimizePointerExited"
                    Click="OnMinimizeClicked">
              <FontIcon Glyph="&#xE921;" FontSize="20" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>
          <Grid>
            <Rectangle x:Name="MaximizeGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="MaximizeButton" Width="36" Height="36"
                    Background="#660A0F1A" BorderBrush="#66112233" BorderThickness="1"
                    CornerRadius="4"
                    PointerEntered="OnMaximizePointerEntered" PointerExited="OnMaximizePointerExited"
                    Click="OnMaximizeClicked">
              <FontIcon Glyph="&#xE922;" FontSize="20" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>
          <Grid>
            <Rectangle x:Name="RestoreGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="RestoreButton" Width="36" Height="36"
                    Background="#660A0F1A" BorderBrush="#66112233" BorderThickness="1"
                    CornerRadius="4"
                    PointerEntered="OnRestorePointerEntered" PointerExited="OnRestorePointerExited"
                    Click="OnRestoreClicked">
              <FontIcon Glyph="&#xE923;" FontSize="20" Foreground="#FFB9EFFF"/>
            </Button>
          </Grid>
          <Grid>
            <Rectangle x:Name="CloseGlow" RadiusX="4" RadiusY="4" Fill="#4000E0FF" Opacity="0"/>
            <Button x:Name="CloseButton" Width="36" Height="36"
                    Background="#660A0F1A" BorderBrush="#66112233" BorderThickness="1"
                    CornerRadius="4"
                    PointerEntered="OnClosePointerEntered" PointerExited="OnClosePointerExited"
                    Click="OnCloseClicked">
              <FontIcon Glyph="&#xE8BB;" FontSize="20" Foreground="#FFFFA3A3"/>
            </Button>
          </Grid>
        </StackPanel>

        <Rectangle VerticalAlignment="Bottom" Height="1" Fill="#5900E0FF"/>
        <Rectangle VerticalAlignment="Bottom" Height="4" Margin="0,1,0,0" IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#40000000" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </Border>
  </Grid>
</UserControl>
