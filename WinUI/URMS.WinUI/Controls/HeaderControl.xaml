<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.HeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid Height="68" Background="Transparent">
    <Border Margin="12,8,12,0" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" Background="{ThemeResource MaterialPanelStrongBrush}">
      <Grid>
        <Rectangle RadiusX="16" RadiusY="16" Opacity="0.03" Fill="{ThemeResource GlobalNoiseBrush}"/>
        <Rectangle Height="24" VerticalAlignment="Top" Margin="1,1,1,0" RadiusX="15" RadiusY="15" Opacity="0.18">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#D10A131E" Offset="0"/>
              <GradientStop Color="#C20B121A" Offset="0.48"/>
              <GradientStop Color="#BE060B11" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="14" VerticalAlignment="Top" Margin="1,1,1,0" RadiusX="15" RadiusY="15" Opacity="0.22">
          <Rectangle.Fill>
            <StaticResource ResourceKey="MaterialShellHighlightBrush"/>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="1" VerticalAlignment="Bottom" Margin="20,0,20,10" Fill="{ThemeResource MaterialStrokeSoftBrush}"/>
        <Rectangle Height="1" VerticalAlignment="Top" Margin="20,10,20,0" Fill="{ThemeResource GlassLineBrush}"/>

        <Grid Margin="20,10,20,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center" CornerRadius="18"
                  BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                  Background="{ThemeResource GlassHeroBrush}">
            <Border.Shadow>
              <ThemeShadow/>
            </Border.Shadow>
            <Image Width="32" Height="32" Stretch="Uniform" Source="ms-appx:///Assets/images/urms_logo.png"/>
          </Border>

          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="URMS" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="26" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource HeaderTitleBrush}"/>
            <TextBlock Grid.Row="1" Text="Unified Resource Management System" FontFamily="{ThemeResource BodyFontFamily}" FontSize="10" CharacterSpacing="30" Foreground="{ThemeResource HeaderSubtitleBrush}" Margin="0,1,0,0"/>
            <StackPanel x:Name="SpectrumPanel" Grid.Row="1" Orientation="Horizontal" Height="1" Opacity="0"/>
          </Grid>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14" Margin="0,0,20,0">
            <TextBlock x:Name="TxtDate" Text="yyyy/MM/dd (ddd)" FontFamily="{ThemeResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtClock" Text="HH:mm:ss" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
          </StackPanel>

          <Grid Grid.Column="3" Width="68" Height="42" Margin="0,0,16,0" VerticalAlignment="Center">
            <Ellipse Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#3A84A8C8" StrokeThickness="1"/>
            <Path Data="M21,21 L40,21 A21,21 0 0 0 36,10 Z" Fill="#2F8EB6D3" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path.RenderTransform>
                <RotateTransform x:Name="RadarRotate" CenterX="21" CenterY="21"/>
              </Path.RenderTransform>
            </Path>
            <Ellipse x:Name="RadarBlip0" Width="4" Height="4" Fill="#E3F4FF" Margin="42,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"/>
            <Ellipse x:Name="RadarBlip1" Width="3" Height="3" Fill="#A8D6F2" Margin="20,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"/>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#B5DEFF" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" Text="SCAN_DONE" FontFamily="{ThemeResource MonoFontFamily}" FontSize="8" CharacterSpacing="80" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Width="30" Height="30" Padding="0" Background="{ThemeResource MaterialButtonBrush}" BorderBrush="{ThemeResource MaterialStrokeBrush}" BorderThickness="1" CornerRadius="15" Click="OnMinimizeClicked">
              <FontIcon Glyph="&#xE921;" FontSize="12" Foreground="#DCE7F1"/>
            </Button>
            <Grid>
              <Button x:Name="MaximizeButton" Width="30" Height="30" Padding="0" Background="{ThemeResource MaterialButtonBrush}" BorderBrush="{ThemeResource MaterialStrokeBrush}" BorderThickness="1" CornerRadius="15" Click="OnMaximizeClicked">
                <FontIcon Glyph="&#xE922;" FontSize="12" Foreground="#DCE7F1"/>
              </Button>
              <Button x:Name="RestoreButton" Width="30" Height="30" Padding="0" Background="{ThemeResource MaterialButtonBrush}" BorderBrush="{ThemeResource MaterialStrokeBrush}" BorderThickness="1" CornerRadius="15" Click="OnRestoreClicked">
                <FontIcon Glyph="&#xE923;" FontSize="12" Foreground="#DCE7F1"/>
              </Button>
            </Grid>
            <Button x:Name="CloseButton" Width="30" Height="30" Padding="0" Background="{ThemeResource MaterialButtonDangerBrush}" BorderBrush="{ThemeResource MaterialButtonDangerStrokeBrush}" BorderThickness="1" CornerRadius="15" Click="OnCloseClicked">
              <FontIcon Glyph="&#xE8BB;" FontSize="12" Foreground="#F2DFE2"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
