<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.CyberCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

  <Grid Background="Transparent">
    <!-- ベース背景: 斜め角カットシェイプ -->
    <Path x:Name="CardShape"
          Fill="{ThemeResource CardBackgroundBrush}"
          Stroke="{ThemeResource CardBorderBrush}"
          StrokeThickness="1"
          Stretch="None"
          Width="0" Height="0"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          IsHitTestVisible="False"/>

        <Border x:Name="CardBorder"
          Background="Transparent"
          CornerRadius="10"
            BorderThickness="0">
          <Border.Shadow>
            <ThemeShadow/>
          </Border.Shadow>

      <Grid>

        <!-- コンテンツ -->
        <ContentPresenter x:Name="InnerContent" Margin="10,8,10,6"/>

        <!-- 微細ノイズレイヤー -->
        <Rectangle IsHitTestVisible="False" Opacity="0.06">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#66FFFFFF" Offset="0"/>
              <GradientStop Color="#11000000" Offset="0.25"/>
              <GradientStop Color="#44FFFFFF" Offset="0.5"/>
              <GradientStop Color="#11000000" Offset="0.75"/>
              <GradientStop Color="#66FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- スイープ光 -->
        <Path x:Name="SweepPath"
              Stretch="None"
              Width="0" Height="0"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Opacity="0" IsHitTestVisible="False">
          <Path.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="Transparent" Offset="0.00"/>
              <GradientStop Color="Transparent" Offset="0.42"/>
              <GradientStop Color="#5000f7ff" Offset="0.50"/>
              <GradientStop Color="Transparent" Offset="0.58"/>
              <GradientStop Color="Transparent" Offset="1.00"/>
              <LinearGradientBrush.RelativeTransform>
                <TranslateTransform x:Name="SweepBrushTransform" X="-1.2"/>
              </LinearGradientBrush.RelativeTransform>
            </LinearGradientBrush>
          </Path.Fill>
        </Path>

        <!-- 上部グラス反射 (Opacity 0.10 サイバー化) -->
        <Rectangle Height="30" VerticalAlignment="Top"
                   HorizontalAlignment="Stretch" IsHitTestVisible="False"
                   Opacity="0.10">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="White"       Offset="0.0"/>
              <GradientStop Color="Transparent" Offset="1.0"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- 上部反射帯（8% 白帯, フェーズ5）-->
        <Rectangle Height="6" VerticalAlignment="Top"
                   HorizontalAlignment="Stretch" IsHitTestVisible="False"
                   Opacity="0.08">
          <Rectangle.Fill><SolidColorBrush Color="White"/></Rectangle.Fill>
        </Rectangle>

        <!-- Hover サイバーグロー (#00E0FF, Opacity 0.25, フェーズ5) -->
        <Rectangle x:Name="HoverGlow"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   IsHitTestVisible="False" Opacity="0">
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
              <GradientStop Color="#4000E0FF" Offset="0.0"/>
              <GradientStop Color="Transparent" Offset="1.0"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

      </Grid>
    </Border>

    <!-- 4隅ブラケット -->
    <!-- 左上 -->
    <Line X1="0" Y1="10" X2="0" Y2="0" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"/>
    <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"/>
    <!-- 右上 -->
    <Line X1="0" Y1="10" X2="0" Y2="0" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"
          HorizontalAlignment="Right" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
      <Line.RenderTransform><ScaleTransform ScaleX="-1"/></Line.RenderTransform>
    </Line>
    <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"
          HorizontalAlignment="Right">
      <Line.RenderTransform><ScaleTransform ScaleX="-1"/></Line.RenderTransform>
    </Line>
    <!-- 左下 -->
    <Line X1="0" Y1="0" X2="0" Y2="10" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"
          VerticalAlignment="Bottom">
      <Line.RenderTransform><ScaleTransform ScaleY="-1"/></Line.RenderTransform>
    </Line>
    <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"
          VerticalAlignment="Bottom">
      <Line.RenderTransform><ScaleTransform ScaleY="-1"/></Line.RenderTransform>
    </Line>
    <!-- 右下 -->
    <Line X1="0" Y1="0" X2="0" Y2="10" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Line.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Line.RenderTransform>
    </Line>
    <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{ThemeResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.6" IsHitTestVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Line.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Line.RenderTransform>
    </Line>
  </Grid>
</UserControl>
