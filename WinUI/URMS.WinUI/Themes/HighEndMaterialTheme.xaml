<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <!-- HIGH-END MATERIAL THEME v2
         This resource dictionary defines all visual parameters (colors, brushes, gradients, opacity values)
         for the high-end material theme. The theme is pluggable: changes here do not affect data logic
         or card information structure.
         
         Card/Dashboard code-behind must reference only theme resource keys, never hard-coded theme values.
    -->

    <!-- MATERIAL PALETTE: Primary Colors and Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#05070B"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0A1220"/>
    <SolidColorBrush x:Key="HeaderTitleBrush" Color="#F2F7FC"/>
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#99AABD"/>
    
    <!-- TEXT AND LABEL COLORS -->
    <SolidColorBrush x:Key="LabelBrush" Color="#AABBCC"/>
    <SolidColorBrush x:Key="ValueBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#C2D2E8"/>
    
    <!-- HERO ACCENT COLORS (Primary Cards) -->
    <SolidColorBrush x:Key="HeroCyanBrush" Color="#7FD4FF"/>
    <SolidColorBrush x:Key="HeroSubBrush" Color="#9AB4CF"/>
    
    <!-- SECONDARY ACCENT COLORS (Secondary and Support Cards) -->
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#4CC3FF"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#4CD964"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFB347"/>
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="#B9A7D6"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#6A83FF"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#D59CA6"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#2FD0C8"/>
    <!-- AccentSubBrush = #2FD0C8 (same as AccentTeal, semantic alias for sub-accent usage) -->
    <SolidColorBrush x:Key="AccentSubBrush" Color="#2FD0C8"/>
    <!-- Semantic text aliases -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5CBD8"/>
    
    <!-- CARD STYLING COLORS -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0B0F18"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334C7A"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#141B2B"/>
    <SolidColorBrush x:Key="CardValueBrush" Color="#F6FAFE"/>
    <SolidColorBrush x:Key="CardLabelBrush" Color="#94A8BC"/>
    <SolidColorBrush x:Key="MaterialShellBrush" Color="#6E101A31"/>
    <SolidColorBrush x:Key="MaterialPanelBrush" Color="#6B162542"/>
    <SolidColorBrush x:Key="MaterialPanelStrongBrush" Color="#8520335B"/>
    <SolidColorBrush x:Key="MaterialStrokeBrush" Color="#7495C4FF"/>
    <SolidColorBrush x:Key="MaterialStrokeSoftBrush" Color="#3654769D"/>
    <SolidColorBrush x:Key="MaterialButtonBrush" Color="#2A213449"/>
    <SolidColorBrush x:Key="MaterialButtonDangerBrush" Color="#2E4E2A31"/>
    <SolidColorBrush x:Key="MaterialButtonDangerStrokeBrush" Color="#588D6670"/>
    <SolidColorBrush x:Key="GlassHeroBrush" Color="#381A3B60"/>
    <SolidColorBrush x:Key="GlassSecondaryBrush" Color="#26122A40"/>
    <SolidColorBrush x:Key="MatteCardBrush" Color="#121D2F"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#1A223A57"/>
    <SolidColorBrush x:Key="HeroCyanGlassBrush" Color="#20376894"/>
    
    <!-- SECTION AND LAYOUT COLORS -->
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#D6E3F5"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#17212D"/>
    
    <!-- MATERIAL TEXTURES -->
    <SolidColorBrush x:Key="GlobalNoiseBrush" Color="#05FFFFFF"/>
    
    <!-- GRADIENT DEFINITIONS (Depth and Glass Effects) -->
    <LinearGradientBrush x:Key="AppDepthGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1020" Offset="0"/>
        <GradientStop Color="#070C16" Offset="0.45"/>
        <GradientStop Color="#05070B" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="GlassLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8EF3FBFF" Offset="0"/>
        <GradientStop Color="#2FCBE7FA" Offset="0.55"/>
        <GradientStop Color="#00CBE7FA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MaterialHeroBandBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#98C7FF" Offset="0"/>
        <GradientStop Color="#4CA3FF" Offset="0.45"/>
        <GradientStop Color="#1E6BDA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MaterialShellHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7CFFFFFF" Offset="0"/>
        <GradientStop Color="#30E7F5FF" Offset="0.55"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MaterialPanelDepthBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C0142038" Offset="0"/>
        <GradientStop Color="#A010182B" Offset="0.5"/>
        <GradientStop Color="#8A0A1020" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="MaterialHeroAuraBrush" Center="0.5,0.45" RadiusX="0.72" RadiusY="0.82">
        <GradientStop Color="#5DA9FF" Offset="0"/>
        <GradientStop Color="#1D7BE6" Offset="0.45"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- ANIMATION PARAMETERS (Stored as doubles for Composition API consumption) -->
    <!-- These values are referenced from CardControl.xaml.cs ApplyState/BuildProfile methods -->
    <!-- Theme switching: replace this entire file to change animation parameters -->
    <x:Double x:Key="CardMotionHoverDuration">160</x:Double>
    <x:Double x:Key="CardMotionActiveDuration">180</x:Double>

</ResourceDictionary>
