<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- HIGH-END MATERIAL THEME v2
         This resource dictionary defines all visual parameters (colors, brushes, gradients, opacity values)
         for the high-end material theme. The theme is pluggable: changes here do not affect data logic
         or card information structure.
         
         Card/Dashboard code-behind must reference only theme resource keys, never hard-coded theme values.
    -->

    <!-- MATERIAL PALETTE: Primary Colors and Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#050A11"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#09111B"/>
    <SolidColorBrush x:Key="HeaderTitleBrush" Color="#E3ECF5"/>
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#8A9DB3"/>
    
    <!-- TEXT AND LABEL COLORS -->
    <SolidColorBrush x:Key="LabelBrush" Color="#7B8EA5"/>
    <SolidColorBrush x:Key="ValueBrush" Color="#DAE5F0"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#A6B8CB"/>
    
    <!-- HERO ACCENT COLORS (Primary Cards) -->
    <SolidColorBrush x:Key="HeroCyanBrush" Color="#A9C5DA"/>
    <SolidColorBrush x:Key="HeroSubBrush" Color="#7E93A8"/>
    
    <!-- SECONDARY ACCENT COLORS (Secondary and Support Cards) -->
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#7FAECC"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#7BB89F"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#C4A26D"/>
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="#A98AAE"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8B8EBA"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#C08A94"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#71A9A4"/>
    
    <!-- CARD STYLING COLORS -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0B121B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2D3E52"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#111B28"/>
    <SolidColorBrush x:Key="CardValueBrush" Color="#EEF4FA"/>
    <SolidColorBrush x:Key="CardLabelBrush" Color="#8A9FB5"/>
    
    <!-- SECTION AND LAYOUT COLORS -->
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#C2D1E0"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#17212D"/>
    
    <!-- MATERIAL TEXTURES -->
    <SolidColorBrush x:Key="GlobalNoiseBrush" Color="#05FFFFFF"/>
    
    <!-- GRADIENT DEFINITIONS (Depth and Glass Effects) -->
    <LinearGradientBrush x:Key="AppDepthGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#08111B" Offset="0"/>
        <GradientStop Color="#060B12" Offset="0.45"/>
        <GradientStop Color="#04080D" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="GlassLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5DD6E8F7" Offset="0"/>
        <GradientStop Color="#14D6E8F7" Offset="0.55"/>
        <GradientStop Color="#00D6E8F7" Offset="1"/>
    </LinearGradientBrush>

    <!-- ANIMATION PARAMETERS (Stored as doubles for Composition API consumption) -->
    <!-- These values are referenced from CardControl.xaml.cs ApplyState/BuildProfile methods -->
    <!-- Theme switching: replace this entire file to change animation parameters -->
    <x:Double x:Key="CardMotionHoverDuration">160</x:Double>
    <x:Double x:Key="CardMotionActiveDuration">180</x:Double>

</ResourceDictionary>
