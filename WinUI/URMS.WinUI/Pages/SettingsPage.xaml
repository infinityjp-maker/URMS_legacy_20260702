<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Page.Resources>
    <Style x:Key="CatButtonStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{ThemeResource MaterialButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource MaterialStrokeSoftBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
      <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="CatButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource CatButtonStyle}">
      <Setter Property="Background" Value="{ThemeResource MaterialPanelStrongBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource MaterialStrokeBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource ValueBrush}"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Rectangle Opacity="0.018" Fill="{ThemeResource GlobalNoiseBrush}"/>
    <Rectangle Opacity="0.08">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#102A3C55" Offset="0"/>
          <GradientStop Color="#00000000" Offset="0.45"/>
          <GradientStop Color="#0D1B2D3F" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnBack" Grid.Column="0" Click="OnBack" Width="42" Height="42" Padding="0" Background="{ThemeResource MaterialButtonBrush}" BorderBrush="{ThemeResource MaterialStrokeBrush}" BorderThickness="1" Foreground="{ThemeResource ValueBrush}" CornerRadius="21">&#xE76B;</Button>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Settings" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="28" FontWeight="SemiBold" CharacterSpacing="40" Foreground="{ThemeResource HeaderTitleBrush}"/>
          <TextBlock Text="Glass controls / restrained highlights / premium operations" FontFamily="{ThemeResource BodyFontFamily}" FontSize="10" CharacterSpacing="20" Foreground="{ThemeResource HeaderSubtitleBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="22" BorderBrush="{ThemeResource MaterialStrokeBrush}" BorderThickness="1" Background="{ThemeResource MaterialShellBrush}" Padding="18">
          <Grid>
            <Rectangle RadiusX="22" RadiusY="22" Fill="{ThemeResource MaterialPanelDepthBrush}"/>
            <Rectangle RadiusX="22" RadiusY="22" Opacity="0.028" Fill="{ThemeResource GlobalNoiseBrush}"/>
            <Rectangle Height="48" Margin="1,1,1,0" VerticalAlignment="Top" RadiusX="21" RadiusY="21" Opacity="0.24" Fill="{ThemeResource MaterialHeroBandBrush}"/>
            <StackPanel Spacing="10" Margin="0">
            <Button x:Name="BtnCatGeneral" Content="GENERAL" Style="{StaticResource CatButtonActiveStyle}" Click="OnCatGeneral"/>
            <Button x:Name="BtnCatUI" Content="UI" Style="{StaticResource CatButtonStyle}" Click="OnCatUi"/>
            <Button x:Name="BtnCatSystem" Content="SYSTEM" Style="{StaticResource CatButtonStyle}" Click="OnCatSystem"/>
            <Button x:Name="BtnCatDeveloper" Content="DEVELOPER" Style="{StaticResource CatButtonStyle}" Click="OnCatDeveloper"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Border CornerRadius="24" BorderBrush="{ThemeResource MaterialStrokeBrush}" BorderThickness="1" Background="{ThemeResource MaterialShellBrush}" Padding="28">
              <Grid>
                <Rectangle RadiusX="24" RadiusY="24" Fill="{ThemeResource MaterialPanelDepthBrush}"/>
                <Rectangle Height="52" Margin="1,1,1,0" VerticalAlignment="Top" RadiusX="23" RadiusY="23" Opacity="0.22" Fill="{ThemeResource MaterialHeroBandBrush}"/>
                <Rectangle Opacity="0.028" Fill="{ThemeResource GlobalNoiseBrush}" RadiusX="24" RadiusY="24"/>
                <StackPanel Spacing="22">
                  <StackPanel x:Name="PanelGeneral" Spacing="16">
                    <TextBlock Text="General" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="18" CharacterSpacing="20" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="Theme" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:Name="CmbTheme" SelectionChanged="OnThemeChanged">
                          <ComboBoxItem x:Name="CmbThemeFuturistic" Content="Futuristic"/>
                          <ComboBoxItem x:Name="CmbThemeDark" Content="Dark"/>
                          <ComboBoxItem x:Name="CmbThemeLight" Content="Light"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Language" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:Name="CmbLanguage" SelectionChanged="OnLanguageChanged">
                          <ComboBoxItem Content="Japanese"/>
                          <ComboBoxItem Content="English"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Version" Foreground="{ThemeResource LabelBrush}"/>
                          <TextBlock x:Name="TxtVersion" Text="1.0.0" Foreground="{ThemeResource ValueBrush}" FontSize="18"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Build Date" Foreground="{ThemeResource LabelBrush}"/>
                          <TextBlock x:Name="TxtBuildDate" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>

                  <StackPanel x:Name="PanelUI" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="UI" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="Accent" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:Name="CmbAccentColor" SelectionChanged="OnAccentColorChanged">
                          <ComboBoxItem Content="Cyan" Tag="#7FAECC"/>
                          <ComboBoxItem Content="Green" Tag="#7BB89F"/>
                          <ComboBoxItem Content="Magenta" Tag="#A98AAE"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Target FPS" Foreground="{ThemeResource LabelBrush}"/>
                        <ComboBox x:Name="CmbTargetFps" SelectionChanged="OnTargetFpsChanged">
                          <ComboBoxItem Content="60 fps" Tag="60"/>
                          <ComboBoxItem Content="90 fps" Tag="90"/>
                          <ComboBoxItem Content="120 fps" Tag="120"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <Border Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Animation Intensity" Foreground="{ThemeResource LabelBrush}"/>
                        <Slider x:Name="SliderAnimIntensity" Minimum="0" Maximum="2" StepFrequency="0.1" Value="1.0" ValueChanged="OnAnimIntensityChanged"/>
                        <TextBlock x:Name="TxtAnimIntensity" Text="1.0x" Foreground="{ThemeResource ValueBrush}" FontSize="18"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel x:Name="PanelSystem" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="System" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <ToggleSwitch x:Name="TogBootAnim" IsOn="True" Toggled="OnBootAnimToggled" Header="Boot animation"/>
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Launch" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtBootLaunch" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/></StackPanel></Border>
                      <Border Grid.Column="1" Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Dashboard" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtBootDash" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/></StackPanel></Border>
                      <Border Grid.Column="2" Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Complete" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtBootComplete" Text="-" Foreground="{ThemeResource ValueBrush}" FontSize="18"/></StackPanel></Border>
                    </Grid>
                  </StackPanel>

                  <StackPanel x:Name="PanelDeveloper" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Developer" FontFamily="Consolas" FontSize="16" CharacterSpacing="120" Foreground="{ThemeResource SectionHeaderBrush}"/>
                    <ToggleSwitch x:Name="TogDebugLog" IsOn="False" Toggled="OnDebugLogToggled" Header="Debug log"/>
                    <Border Background="{ThemeResource MaterialPanelBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Settings Path" Foreground="{ThemeResource LabelBrush}"/>
                        <TextBlock x:Name="TxtSettingsPath" Text="-" Foreground="{ThemeResource ValueBrush}" TextWrapping="WrapWholeWords"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Margin="0,24,0,0" Padding="14,12" CornerRadius="14" Background="{ThemeResource MaterialShellBrush}" BorderThickness="1" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}">
        <TextBlock x:Name="TxtApplyStatus" Text="Idle" Foreground="{ThemeResource ValueBrush}"/>
      </Border>
    </Grid>
  </Grid>
</Page>
