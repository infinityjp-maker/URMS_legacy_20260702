<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">

  <Page.Resources>
    <Style x:Key="SectionCardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CharacterSpacing" Value="80"/>
      <Setter Property="Foreground" Value="{ThemeResource CardTitleBrush}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{ThemeResource ValueBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ページヘッダー -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="20,16,20,8">
      <Button x:Name="BtnBack" Click="OnBack"
              Background="Transparent" BorderThickness="0"
              Foreground="{ThemeResource AccentCyanBrush}"
              FontSize="18" Padding="4" VerticalAlignment="Center">
        &#xE76B;
      </Button>
      <TextBlock Text="SETTINGS" FontSize="22" FontWeight="ExtraBold"
                 CharacterSpacing="100" Foreground="{ThemeResource HeaderTitleBrush}"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <!-- コンテンツ -->
    <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
      <StackPanel Spacing="0" MaxWidth="640" HorizontalAlignment="Left">

        <!-- 表示設定 -->
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="DISPLAY" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock Text="選択すると即時に適用されます"
                       FontSize="11" Foreground="{ThemeResource LabelBrush}" Margin="0,0,0,12"/>

            <!-- テーマ -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="テーマ" Style="{StaticResource LabelStyle}"/>
              <ComboBox x:Name="CmbTheme" Grid.Column="1" Width="160"
                        SelectionChanged="OnThemeChanged">
                <ComboBoxItem x:Name="CmbThemeFuturistic" Content="未来 (Futuristic)"/>
                <ComboBoxItem x:Name="CmbThemeDark"       Content="ダーク (Dark)"/>
                <ComboBoxItem x:Name="CmbThemeLight"      Content="ライト (Light)"/>
              </ComboBox>
            </Grid>

            <!-- 言語 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="言語 / Language" Style="{StaticResource LabelStyle}"/>
              <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="160"
                        SelectionChanged="OnLanguageChanged">
                <ComboBoxItem Content="日本語"/>
                <ComboBoxItem Content="English"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- バージョン情報 -->
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel Spacing="10">
            <TextBlock Text="ABOUT" Style="{StaticResource SectionTitleStyle}"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="アプリケーション" Style="{StaticResource LabelStyle}"/>
              <TextBlock Grid.Column="1" Text="URMS" Style="{StaticResource ValueStyle}"/>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="バージョン" Style="{StaticResource LabelStyle}"/>
              <TextBlock x:Name="TxtVersion" Grid.Column="1" Text="1.0.0" Style="{StaticResource ValueStyle}"/>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="フレームワーク" Style="{StaticResource LabelStyle}"/>
              <TextBlock Grid.Column="1" Text="WinUI 3 / .NET 8" Style="{StaticResource ValueStyle}"/>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="ビルド日時" Style="{StaticResource LabelStyle}"/>
              <TextBlock x:Name="TxtBuildDate" Grid.Column="1" Text="-" Style="{StaticResource ValueStyle}"/>
            </Grid>

          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Margin="20,0,20,14" Padding="10,8"
            CornerRadius="8" BorderThickness="1"
            BorderBrush="{ThemeResource CardBorderBrush}" Background="#1A00f7ff">
      <TextBlock x:Name="TxtApplyStatus" Text="待機中"
                 FontFamily="Consolas" FontSize="11" CharacterSpacing="20"
                 Foreground="{ThemeResource AccentCyanBrush}"/>
    </Border>
  </Grid>
</Page>
