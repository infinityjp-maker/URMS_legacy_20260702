<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:URMS.WinUI.Controls"
    Background="Transparent">

  <Page.Resources>

    <SolidColorBrush x:Key="LabelBrush" Color="#FF00F7FF"/>
    <SolidColorBrush x:Key="ValueBrush" Color="#FF00F7FF"/>
    <SolidColorBrush x:Key="HeroSubBrush" Color="#FF00F7FF"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#FF00F7FF"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource AccentCyanBrush}"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily"      Value="Consolas"/>
      <Setter Property="FontSize"        Value="9"/>
      <Setter Property="FontWeight"      Value="Bold"/>
      <Setter Property="CharacterSpacing" Value="390"/>
      <Setter Property="Foreground"      Value="{ThemeResource CardTitleBrush}"/>
    </Style>

    <!-- カードタイトルコンテナ（::before 左線 + テキスト + ::after 右グラデーション） -->
    <ControlTemplate x:Key="CardTitleCyan">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
        <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#2e00f7ff" Offset="0"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </ControlTemplate>

    <Style x:Key="HudLineStyle" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="0,3,0,6"/>
      <Setter Property="Fill">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3000f7ff" Offset="0.0"/>
            <GradientStop Color="#1800f7ff" Offset="0.4"/>
            <GradientStop Color="Transparent"  Offset="1.0"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A0F1A" Offset="0"/>
        <GradientStop Color="#FF0F1A2A" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
      <StackPanel Spacing="30" Padding="44,36" MaxWidth="1720" HorizontalAlignment="Center">

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
            <TextBlock FontFamily="Consolas" FontSize="20" CharacterSpacing="350" Foreground="{ThemeResource HeroCyanBrush}">
              <Run Text="//" Foreground="#5900f7ff" FontSize="14"/>
              <Run Text=" 統合オペレーション "/>
              <Run Text="//" Foreground="#5900f7ff" FontSize="14"/>
              <Run Text=" DASHBOARD"/>
            </TextBlock>
            <TextBlock Text="UNIFIED RESOURCE MANAGEMENT SYSTEM — SECTOR 7 · NODE ALPHA"
                       FontFamily="Consolas" FontSize="9" CharacterSpacing="278"
                       Foreground="{ThemeResource HeroSubBrush}"/>
          </StackPanel>
          <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="320">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1" Margin="0,0,10,0">
              <TextBlock Text="SESSION" FontFamily="Consolas" FontSize="7" CharacterSpacing="222"
                         Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right"/>
              <TextBlock x:Name="TxtSessionId" Text="---" FontFamily="Consolas" FontSize="9" CharacterSpacing="150"
                         Foreground="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Right"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#0f00ff88" BorderBrush="#3300ff88"
                    BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="SYSTEM NOMINAL" FontFamily="Consolas" FontSize="9" CharacterSpacing="30"
                           Foreground="{ThemeResource AccentGreenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
              <Button x:Name="BtnWinMin" Content="—" Width="28" Height="24" Padding="0"
                      Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1"
                      Foreground="{ThemeResource AccentCyanBrush}" FontFamily="Consolas" FontSize="13"
                      Click="OnWinMinClick"/>
              <Button x:Name="BtnWinMax" Content="□" Width="28" Height="24" Padding="0"
                      Background="#1400f7ff" BorderBrush="#3500f7ff" BorderThickness="1"
                      Foreground="{ThemeResource AccentCyanBrush}" FontFamily="Consolas" FontSize="12"
                      Click="OnWinMaxClick"/>
              <Button x:Name="BtnWinClose" Content="×" Width="28" Height="24" Padding="0"
                      Background="#1fFF3A3A" BorderBrush="#55FF3A3A" BorderThickness="1"
                      Foreground="#FFFF9090" FontFamily="Consolas" FontSize="12"
                      Click="OnWinCloseClick"/>
            </StackPanel>
          </Grid>
        </Grid>

        <TextBlock Text="SYSTEM LAYER / システムレイヤー" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Foreground="{ThemeResource AccentCyanBrush}" Margin="0,14,0,16"/>

        <!-- System Top Row: Schedule, Weather, Tasks, Security -->
        <Grid ColumnSpacing="32" RowSpacing="32" Margin="0,0,0,34">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>

          <ctrl:CardControl x:Name="CardTask" Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" BaseGlowOpacity="0.27" HoverGlowOpacity="0.29" IsPrimaryTone="True" TitleText="TASKS" MainValueText="5 / 8" SubInfoText="今日の進行状況" IconGlyph="&#xE823;">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtCardTask" Style="{StaticResource CardTitleStyle}" Text="TASKS"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="22" Foreground="{ThemeResource AccentGreenBrush}">
                  <Run Text="5"/><Run Text=" / 8" FontSize="13" Foreground="{ThemeResource LabelBrush}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="62%" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource AccentGreenBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
              </Grid>
              <ProgressBar x:Name="BarTaskPct" Value="62" Height="5" Margin="0,8,0,0" Foreground="{ThemeResource AccentGreenBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="完了: "/><Run Text="5" Foreground="{ThemeResource AccentGreenBrush}"/></TextBlock>
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="未了: "/><Run Text="3" Foreground="{ThemeResource AccentAmberBrush}"/></TextBlock>
                <TextBlock FontSize="9" Foreground="{ThemeResource LabelBrush}"><Run Text="優先: "/><Run Text="1" Foreground="{ThemeResource AccentRedBrush}"/></TextBlock>
              </StackPanel>
            </StackPanel>
          </ctrl:CardControl>

          <ctrl:CardControl x:Name="CardWeather" Grid.Row="1" Grid.Column="0" Margin="0,2,0,2" BaseGlowOpacity="0.18" HoverGlowOpacity="0.20" TitleText="WEATHER" MainValueText="22°C" SubInfoText="" IconGlyph="&#xE706;">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtCardWeather" Style="{StaticResource CardTitleStyle}" Text="WEATHER"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctrl:WeatherAnimation x:Name="WxAnim" Grid.Column="0" Condition="sunny" Height="56" Width="56"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2" VerticalAlignment="Top">
                  <TextBlock x:Name="TxtWeatherTemp" Text="22°C" FontFamily="Consolas" FontSize="26" CharacterSpacing="8" Foreground="{ThemeResource AccentCyanBrush}"/>
                  <TextBlock x:Name="TxtWeatherDesc" Text="Tokyo · Minato" FontSize="9" Foreground="{ThemeResource LabelBrush}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ctrl:CardControl>

          <ctrl:CardControl x:Name="CardSysmon" Grid.Row="0" Grid.Column="0" Margin="0,6,0,6" BaseGlowOpacity="0.27" HoverGlowOpacity="0.29" IsPrimaryTone="True" TitleText="SYSTEM HEALTH" MainValueText="98 / 100" SubInfoText="Primary Node Integrity" IconGlyph="&#xE9CE;">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="SYSTEM MONITOR" Style="{StaticResource CardTitleStyle}"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="8,3" Background="#16324E66" BorderBrush="#3A6EAFC8" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                  <TextBlock Text="PRIMARY" FontFamily="Consolas" FontSize="8" CharacterSpacing="90" Foreground="{ThemeResource AccentCyanBrush}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="All Core Services Stable" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="CPU" FontFamily="Consolas" FontSize="9" CharacterSpacing="60" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  <ctrl:AnalogGauge x:Name="GaugeCpu" Value="72" Label="CPU" GaugeColor="#00d4f0" Width="86" Height="76"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="MEMORY" FontFamily="Consolas" FontSize="9" CharacterSpacing="60" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  <ctrl:AnalogGauge x:Name="GaugeRam" Value="58" Label="RAM" GaugeColor="#00e676" Width="86" Height="76"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="GPU" FontFamily="Consolas" FontSize="9" CharacterSpacing="60" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
                  <ctrl:AnalogGauge x:Name="GaugeGpu" Value="45" Label="GPU" GaugeColor="#d080ff" Width="86" Height="76"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,10,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="SERVICES" FontFamily="Consolas" FontSize="8" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Text="18 / 18" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentGreenBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                  <TextBlock Text="ALERTS" FontFamily="Consolas" FontSize="8" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Text="0" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                  <TextBlock Text="NODES" FontFamily="Consolas" FontSize="8" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right"/>
                  <TextBlock Text="4 ACTIVE" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource ValueBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="THERMAL / I-O / BUS: NOMINAL" FontFamily="Consolas" FontSize="9" CharacterSpacing="35" Foreground="{ThemeResource ValueBrush}" Margin="0,2,0,6"/>
              <TextBlock Text="POWER PROFILE: PERFORMANCE STABLE" FontFamily="Consolas" FontSize="9" CharacterSpacing="35" Foreground="{ThemeResource ValueBrush}" Margin="0,0,0,6"/>
              <TextBlock Text="SERVICE LATENCY ENVELOPE: WITHIN RANGE" FontFamily="Consolas" FontSize="9" CharacterSpacing="35" Foreground="{ThemeResource ValueBrush}" Margin="0,0,0,6"/>
              <TextBlock Text="DISK USAGE" FontFamily="Consolas" FontSize="8" CharacterSpacing="60" FontWeight="Bold" Foreground="{ThemeResource CardTitleBrush}" Margin="0,12,0,4"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="C:" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="BarDiskC" Value="68" Height="8" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtDiskC" Text="68%" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="D:" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="BarDiskD" Value="42" Height="8" Foreground="{ThemeResource AccentGreenBrush}" Background="{ThemeResource ProgressTrackBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtDiskD" Text="42%" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NAS" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="BarDiskNas" Value="31" Height="8" Foreground="{ThemeResource AccentPurpleBrush}" Background="{ThemeResource ProgressTrackBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtDiskNas" Text="31%" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource LabelBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </ctrl:CardControl>

          <ctrl:CardControl x:Name="CardSecurity" Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" BaseGlowOpacity="0.18" HoverGlowOpacity="0.20" TitleText="SECURITY" MainValueText="PROTECTED" SubInfoText="" IconGlyph="&#xE72E;">
            <StackPanel Spacing="0">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentGreenBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="SECURITY" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource AccentGreenBrush}"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00ff88" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Height="1" Margin="0,4,0,10">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3000ff88" Offset="0.0"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🛡" FontFamily="Segoe UI Emoji" FontSize="26" Foreground="{ThemeResource AccentGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="PROTECTED" FontFamily="Consolas" FontSize="13" CharacterSpacing="20" Foreground="{ThemeResource AccentGreenBrush}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ctrl:CardControl>
        </Grid>

        <Grid ColumnSpacing="32" Margin="0,8,0,16" Opacity="0.93">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="2.1*"/>
            <ColumnDefinition Width="1.1*"/>
          </Grid.ColumnDefinitions>

          <ctrl:CardControl x:Name="CardSchedule" Grid.Column="0" Margin="0,4,0,4" BaseGlowOpacity="0.14" HoverGlowOpacity="0.15" TitleText="SCHEDULE" MainValueText="09:30" SubInfoText="朝会 (15min) / 13:00 週次レビュー" IconGlyph="&#xE787;">
            <StackPanel Spacing="0" Padding="4,4,4,4">
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AccentCyanBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtCardSchedule" Style="{StaticResource CardTitleStyle}" Text="SCHEDULE"/>
                <Rectangle Grid.Column="3" Height="1" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2e00f7ff" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              </Grid>
              <Rectangle Style="{StaticResource HudLineStyle}"/>
              <TextBlock Text="09:30" FontFamily="Consolas" FontSize="18" CharacterSpacing="30" Foreground="{ThemeResource AccentCyanBrush}"/>
              <TextBlock x:Name="TxtSchedNext" Text="朝会 (15min)" FontSize="10" Foreground="{ThemeResource LabelBrush}" Margin="0,2,0,0"/>
              <Rectangle Height="1" Margin="0,8" Opacity="0.15" Fill="{ThemeResource CardBorderBrush}"/>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="13:00" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource LabelBrush}" Width="48"/>
                <TextBlock Grid.Column="1" Text="週次レビュー" FontSize="10" Foreground="{ThemeResource ValueBrush}"/>
              </Grid>
            </StackPanel>
          </ctrl:CardControl>

          <ctrl:CardControl x:Name="CardCalendar" Grid.Column="1" Margin="0,4,0,4" BaseGlowOpacity="0.14" HoverGlowOpacity="0.15" TitleText="CALENDAR" MainValueText="2026/05" SubInfoText="予定とマーカーを日付グリッドで確認" IconGlyph="&#xE787;">
            <StackPanel Spacing="6" Padding="16,14,16,12">
              <TextBlock Text="CALENDAR" FontFamily="Consolas" FontSize="9" CharacterSpacing="150" Foreground="{ThemeResource AccentCyanBrush}"/>
              <TextBlock x:Name="TxtCalendarMonth" Text="2026/05" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ValueBrush}"/>
              <Border Background="#14FFFFFF" BorderBrush="#3300E0FF" BorderThickness="1" CornerRadius="8" Padding="8,8,8,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="S" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FFFF6B6B"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="M" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="T" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="W" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="4" Text="T" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="5" Text="F" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="6" Text="S" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FFFF6B6B"/>
                  <TextBlock Grid.Row="1" Grid.Column="4" Text="1" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="5" Text="2" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="6" Text="3" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="#FFFF6B6B"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="4" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="#FFFF6B6B"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="5" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="6" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <Border Grid.Row="2" Grid.Column="3" Background="#3600E0FF" BorderBrush="#A000E0FF" BorderThickness="1" CornerRadius="3" Width="20" Height="18" HorizontalAlignment="Center">
