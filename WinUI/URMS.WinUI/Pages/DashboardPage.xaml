<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:URMS.WinUI.Controls"
    Background="Transparent">

  <Page.Resources>
    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="56"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{ThemeResource HeaderTitleBrush}"/>
    </Style>

    <Style x:Key="MicroLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{ThemeResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="CharacterSpacing" Value="80"/>
      <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
    </Style>

    <Style x:Key="PrimaryCardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource MaterialStrokeSoftBrush}"/>
      <Setter Property="Background" Value="{ThemeResource GlassHeroBrush}"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>

    <Style x:Key="SecondaryCardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource MaterialStrokeSoftBrush}"/>
      <Setter Property="Background" Value="{ThemeResource GlassSecondaryBrush}"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="SupportCardStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource MaterialStrokeSoftBrush}"/>
      <Setter Property="Background" Value="{ThemeResource MatteCardBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
  </Page.Resources>

  <Grid Padding="12,10,12,10">
    <Rectangle Opacity="0.016" Fill="{ThemeResource GlobalNoiseBrush}"/>

    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="84"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              CornerRadius="18"
              BorderBrush="{ThemeResource MaterialStrokeSoftBrush}"
              BorderThickness="1"
              Background="{ThemeResource MaterialPanelStrongBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Width="44" Height="44" Margin="0,14,0,12"
                  CornerRadius="14"
                  HorizontalAlignment="Center"
                  BorderBrush="{ThemeResource MaterialStrokeSoftBrush}"
                  BorderThickness="1"
                  Background="{ThemeResource GlassSecondaryBrush}">
            <TextBlock Text="U"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{ThemeResource DisplayFontFamily}"
                       FontSize="22"
                       Foreground="{ThemeResource AccentCyanBrush}"/>
          </Border>

          <StackPanel Grid.Row="1" Margin="8,0,8,0" Spacing="8">
            <Grid>
              <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5"
                         HorizontalAlignment="Left" Fill="{ThemeResource AccentCyanBrush}"/>
              <Button Style="{StaticResource NavButtonStyle}"
                      Click="OnNavDashboard"
                      Background="{ThemeResource SidebarActiveBrush}"
                      BorderBrush="{ThemeResource AccentCyanBrush}">
                <FontIcon Glyph="&#xE8F1;" FontSize="22" Foreground="{ThemeResource AccentCyanBrush}"/>
              </Button>
            </Grid>

            <Button x:Name="BtnNavWeather" Style="{StaticResource NavButtonStyle}" Click="OnNavWeather" ToolTipService.ToolTip="Weather">
              <FontIcon Glyph="&#xE706;" FontSize="22"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="Systems">
              <FontIcon Glyph="&#xE7C1;" FontSize="22"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="Workflows">
              <FontIcon Glyph="&#xE8A5;" FontSize="22"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="Logs">
              <FontIcon Glyph="&#xE9D2;" FontSize="22"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="Settings">
              <FontIcon Glyph="&#xE713;" FontSize="22"/>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,0,0,14" Spacing="4" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtSessionId" Text="---" Style="{StaticResource MicroLabelStyle}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="54"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="226"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="196"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="14"
                BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                Background="{ThemeResource GlassSecondaryBrush}" Padding="16,0">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DASHBOARD"
                       VerticalAlignment="Center"
                       FontFamily="{ThemeResource DisplayFontFamily}"
                       FontSize="22"
                       Foreground="{ThemeResource HeaderTitleBrush}"/>

            <Border Grid.Column="1" Height="34" VerticalAlignment="Center"
                    CornerRadius="10"
                    BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                    Background="{ThemeResource MatteCardBrush}">
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Search systems, pipelines, incidents" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
              </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ctrl:WeatherAnimation x:Name="WxAnim" Condition="partly_cloudy" Width="22" Height="22"/>
              <TextBlock x:Name="TxtWeatherTemp" Text="22C" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="16" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:Name="TxtWeatherDesc" Text="Tokyo" Foreground="{ThemeResource LabelBrush}" FontSize="11"/>
              <TextBlock x:Name="TxtCardWeather" Text="" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Column="3" Height="32" VerticalAlignment="Center"
                    CornerRadius="10" BorderThickness="1"
                    BorderBrush="{ThemeResource MaterialStrokeSoftBrush}"
                    Background="{ThemeResource MatteCardBrush}" Padding="12,0">
              <TextBlock Text="Operator: Takuya" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.32*"/>
            <ColumnDefinition Width="0.86*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource PrimaryCardStyle}" Tapped="OnCardWeatherTapped">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Text="SYSTEM" Style="{StaticResource MicroLabelStyle}"/>

              <Grid Grid.Row="1" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Unified Operations" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="26" Foreground="{ThemeResource HeaderTitleBrush}"/>
                  <TextBlock x:Name="TxtCardSchedule" Text="Workflow health"
                             FontFamily="{ThemeResource MonoFontFamily}" FontSize="11" CharacterSpacing="80"
                             Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Text="98.4" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="56" Foreground="{ThemeResource ValueBrush}"/>
                  <TextBlock Text="All critical systems nominal" FontFamily="{ThemeResource BodyFontFamily}" FontSize="14" Foreground="{ThemeResource LabelBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Width="124" Height="124" CornerRadius="62"
                        Background="{ThemeResource HeroCyanGlassBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                    <FontIcon Glyph="&#xEC4A;" FontSize="30" Foreground="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="SYSTEM" Style="{StaticResource MicroLabelStyle}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Button Grid.Row="2" HorizontalAlignment="Left" CornerRadius="18" Padding="14,7"
                      BorderThickness="0" Background="{ThemeResource AccentCyanBrush}" Foreground="#081320">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Open Weather Layer" FontFamily="{ThemeResource BodyFontFamily}"/>
                  <FontIcon Glyph="&#xE76C;"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource SecondaryCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Text="System Health Score" Style="{StaticResource SectionTitleStyle}"/>

              <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="98.4" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="48" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock x:Name="TxtOpHealth" Text="NOMINAL" FontFamily="{ThemeResource MonoFontFamily}" FontSize="12" Foreground="{ThemeResource AccentCyanBrush}"/>
                <TextBlock x:Name="TxtOpAlerts" Text="Alerts: 0" FontFamily="{ThemeResource MonoFontFamily}" FontSize="11" Foreground="{ThemeResource LabelBrush}"/>
                <TextBlock x:Name="TxtOpTasks" Text="Running Tasks: 2" FontFamily="{ThemeResource MonoFontFamily}" FontSize="11" Foreground="{ThemeResource LabelBrush}"/>
              </StackPanel>

              <Border Grid.Row="2" CornerRadius="10" Padding="8,6"
                      BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                      Background="{ThemeResource MatteCardBrush}">
                <TextBlock Text="Target reliability: 95.0" Style="{StaticResource MicroLabelStyle}"/>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="10" RowSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SecondaryCardStyle}">
            <StackPanel Spacing="6">
              <TextBlock Text="CPU" Style="{StaticResource MicroLabelStyle}"/>
              <ctrl:AnalogGauge x:Name="GaugeCpu" Value="72" Label="" GaugeColor="#4CC3FF" Height="74"/>
              <TextBlock Text="Core utilization" Foreground="{ThemeResource LabelBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SecondaryCardStyle}">
            <StackPanel Spacing="6">
              <TextBlock Text="RAM" Style="{StaticResource MicroLabelStyle}"/>
              <ctrl:AnalogGauge x:Name="GaugeRam" Value="58" Label="" GaugeColor="#2FD0C8" Height="74"/>
              <TextBlock Text="Memory pressure" Foreground="{ThemeResource LabelBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryCardStyle}">
            <StackPanel Spacing="6">
              <TextBlock Text="GPU" Style="{StaticResource MicroLabelStyle}"/>
              <ctrl:AnalogGauge x:Name="GaugeGpu" Value="45" Label="" GaugeColor="#6A83FF" Height="74"/>
              <TextBlock Text="Render workload" Foreground="{ThemeResource LabelBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SecondaryCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="NETWORK" Style="{StaticResource MicroLabelStyle}"/>
              <Canvas Grid.Row="1" x:Name="NetWaveCanvas" Height="56" Margin="0,8,0,0"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock x:Name="TxtCardTask" Text="TASK QUEUE" Style="{StaticResource MicroLabelStyle}"/>
              <TextBlock Text="850" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="36" Foreground="{ThemeResource ValueBrush}"/>
              <ProgressBar x:Name="BarTaskPct" Value="62" Height="8"
                           Foreground="{ThemeResource AccentCyanBrush}"
                           Background="{ThemeResource ProgressTrackBrush}"/>
              <TextBlock Text="On track for release" Foreground="{ThemeResource LabelBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="STORAGE" Style="{StaticResource MicroLabelStyle}"/>

              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="C:" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}" FontSize="11"/>
                <ProgressBar Grid.Column="1" x:Name="BarDiskC" Height="6" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                <TextBlock Grid.Column="2" x:Name="TxtDiskC" Text="--" HorizontalAlignment="Right" Foreground="{ThemeResource LabelBrush}" FontSize="10"/>
              </Grid>

              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="D:" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}" FontSize="11"/>
                <ProgressBar Grid.Column="1" x:Name="BarDiskD" Height="6" Foreground="{ThemeResource AccentTealBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                <TextBlock Grid.Column="2" x:Name="TxtDiskD" Text="--" HorizontalAlignment="Right" Foreground="{ThemeResource LabelBrush}" FontSize="10"/>
              </Grid>

              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="NAS" VerticalAlignment="Center" Foreground="{ThemeResource ValueBrush}" FontSize="11"/>
                <ProgressBar Grid.Column="1" x:Name="BarDiskNas" Height="6" Foreground="{ThemeResource AccentPurpleBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                <TextBlock Grid.Column="2" x:Name="TxtDiskNas" Text="--" HorizontalAlignment="Right" Foreground="{ThemeResource LabelBrush}" FontSize="10"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="6" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="0.7*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource SupportCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Text="OPERATION" Style="{StaticResource SectionTitleStyle}"/>

              <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="8" Padding="8,6" Background="#0A1522">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PIPELINE" Style="{StaticResource MicroLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="RUNS" Style="{StaticResource MicroLabelStyle}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="ERR" Style="{StaticResource MicroLabelStyle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="UPTIME" Style="{StaticResource MicroLabelStyle}" HorizontalAlignment="Right"/>
              </Grid>

              <Grid Grid.Row="2" Margin="0,2,0,0" ColumnSpacing="8" Padding="8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Core API" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Grid.Column="1" Text="12,450" HorizontalAlignment="Right" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Grid.Column="2" Text="5" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                <TextBlock Grid.Column="3" Text="99.98%" HorizontalAlignment="Right" Foreground="{ThemeResource AccentCyanBrush}"/>
              </Grid>

              <Grid Grid.Row="3" Margin="0,2,0,0" ColumnSpacing="8" Padding="8,6" Background="#08121E">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Deploy Service" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Grid.Column="1" Text="12,980" HorizontalAlignment="Right" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Grid.Column="2" Text="3" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                <TextBlock Grid.Column="3" Text="99.99%" HorizontalAlignment="Right" Foreground="{ThemeResource AccentCyanBrush}"/>
              </Grid>

              <Grid Grid.Row="4" Margin="0,2,0,0" ColumnSpacing="8" Padding="8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cache Layer" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Grid.Column="1" Text="8,320" HorizontalAlignment="Right" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Grid.Column="2" Text="0" HorizontalAlignment="Center" Foreground="{ThemeResource AccentGreenBrush}"/>
                <TextBlock Grid.Column="3" Text="99.97%" HorizontalAlignment="Right" Foreground="{ThemeResource AccentCyanBrush}"/>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource SupportCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="READINESS" Style="{StaticResource SectionTitleStyle}"/>
              <ProgressBar Value="80" Height="8" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
              <TextBlock Text="80% completed" Foreground="{ThemeResource LabelBrush}"/>
              <TextBlock Text="Code Freeze -> Production" Style="{StaticResource MicroLabelStyle}"/>
              <ctrl:WorkflowCard x:Name="OpWorkflowCard" Visibility="Collapsed"/>
              <ctrl:AnalogGauge x:Name="GaugeCpu2" Value="98" Label="" GaugeColor="#4CC3FF" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Page>
