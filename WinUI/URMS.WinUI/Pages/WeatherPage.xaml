<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.WeatherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:URMS.WinUI.Controls"
    Background="Transparent">

  <Page.Resources>
    <Style x:Key="WxSidebarBtnStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0,10"/>
      <Setter Property="Margin" Value="8,0,8,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{ThemeResource LabelBrush}"/>
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{ThemeResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="CharacterSpacing" Value="80"/>
      <Setter Property="Foreground" Value="#AABBCC"/>
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{ThemeResource ValueBrush}"/>
    </Style>
  </Page.Resources>

  <Grid Padding="10,8,10,8">
    <Rectangle Opacity="0.018" Fill="{ThemeResource GlobalNoiseBrush}"/>

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="62"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="18"
              BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
              Background="{ThemeResource MaterialPanelStrongBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Margin="10,14,10,10" CornerRadius="12" Width="38" Height="38"
                  Background="#1A3A6080" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                  HorizontalAlignment="Center">
            <TextBlock Text="U" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource AccentCyanBrush}"/>
          </Border>
          <StackPanel Grid.Row="1" Margin="0,4,0,4">
            <Button Style="{StaticResource WxSidebarBtnStyle}" Click="OnNavDashboard">
              <FontIcon Glyph="&#xE8F1;" FontSize="18"/>
            </Button>
            <Button Style="{StaticResource WxSidebarBtnStyle}"
                    Background="#182A4A" BorderThickness="1" BorderBrush="{ThemeResource AccentCyanBrush}">
              <FontIcon Glyph="&#xE706;" FontSize="18" Foreground="{ThemeResource AccentCyanBrush}"/>
            </Button>
            <Button Style="{StaticResource WxSidebarBtnStyle}">
              <FontIcon Glyph="&#xE9CE;" FontSize="18"/>
            </Button>
            <Button Style="{StaticResource WxSidebarBtnStyle}">
              <FontIcon Glyph="&#xE7C1;" FontSize="18"/>
            </Button>
            <Button Style="{StaticResource WxSidebarBtnStyle}">
              <FontIcon Glyph="&#xE713;" FontSize="18"/>
            </Button>
          </StackPanel>
          <FontIcon Grid.Row="2" Glyph="&#xE77B;" FontSize="20" Margin="0,0,0,16"
                    Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="158"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="14"
                BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                Background="#0C1523" Padding="16,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE706;" FontSize="18" Foreground="{ThemeResource AccentCyanBrush}"/>
              <TextBlock Text="WEATHER" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="20"
                         VerticalAlignment="Center" Foreground="{ThemeResource HeaderTitleBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="8" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}"
                    BorderThickness="1" Background="#101B2A" Height="30" VerticalAlignment="Center">
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Search city" Margin="8,0,0,0"
                           Foreground="{ThemeResource LabelBrush}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Button Grid.Column="2" Click="OnNavDashboard" Height="30" CornerRadius="8" Padding="12,0"
                    BorderThickness="1" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}"
                    Background="#132236" Foreground="{ThemeResource ValueBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE72B;"/>
                <TextBlock Text="Back"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="20" Padding="16,16,16,14"
                  BorderThickness="1" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}">
              <Border.Background>
                <SolidColorBrush Color="#731A3B60"/>
              </Border.Background>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtMainLocation" Text="Tokyo, Minato-ku"
                           FontFamily="{ThemeResource MonoFontFamily}" FontSize="11"
                           Foreground="#AABBCC" CharacterSpacing="80"/>

                <Grid Grid.Row="1" Margin="0,10,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ctrl:WeatherAnimation x:Name="WxMainAnim" Width="76" Height="76" Condition="partly_cloudy"/>
                  <TextBlock x:Name="TxtMainTemp" Grid.Column="1" Text="22C"
                             FontFamily="{ThemeResource DisplayFontFamily}" FontSize="52"
                             VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#F8FDFF"/>
                </Grid>

                <TextBlock x:Name="TxtMainDesc" Grid.Row="2" Text="Partly Cloudy"
                           FontFamily="{ThemeResource DisplayFontFamily}" FontSize="14"
                           Foreground="#AABBCC" Margin="0,0,0,10"/>

                <Grid Grid.Row="3" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="WIND" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock x:Name="TxtWind" Text="12 km/h" Style="{StaticResource StatValueStyle}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="HUMID" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock x:Name="TxtHumidity" Text="68%" Style="{StaticResource StatValueStyle}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="UV" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock x:Name="TxtUvIndex" Text="4" Style="{StaticResource StatValueStyle}"/>
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="HIGH" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock x:Name="TxtTempHigh" Text="26C" Style="{StaticResource StatValueStyle}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="LOW" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock x:Name="TxtTempLow" Text="17C" Style="{StaticResource StatValueStyle}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="FEELS" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock x:Name="TxtFeelsLike" Text="20C" Style="{StaticResource StatValueStyle}"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="8">
                    <Border CornerRadius="16" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                      Padding="10,8">
                <Border.Background>
                  <SolidColorBrush Color="#40122A40"/>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="New York" Foreground="{ThemeResource ValueBrush}"/>
                  <TextBlock Grid.Column="1" Text="14C" Foreground="{ThemeResource AccentCyanBrush}"/>
                </Grid>
              </Border>
                    <Border CornerRadius="16" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                      Padding="10,8">
                <Border.Background>
                  <SolidColorBrush Color="#40122A40"/>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="California" Foreground="{ThemeResource ValueBrush}"/>
                  <TextBlock Grid.Column="1" Text="26C" Foreground="{ThemeResource AccentAmberBrush}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>

          <Border Grid.Column="1" CornerRadius="18"
                  BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                  Background="#0C1525" Padding="12,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="NEXT 7 DAYS"
                         FontFamily="{ThemeResource MonoFontFamily}" FontSize="11" CharacterSpacing="120"
                         Foreground="{ThemeResource LabelBrush}"/>
              <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="8">
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tomorrow" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="23C" Foreground="{ThemeResource ValueBrush}"/></Grid>
                </Border>
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mon" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="21C" Foreground="{ThemeResource ValueBrush}"/></Grid></Border>
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tue" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="20C" Foreground="{ThemeResource ValueBrush}"/></Grid></Border>
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Wed" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="18C" Foreground="{ThemeResource ValueBrush}"/></Grid></Border>
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Thu" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="19C" Foreground="{ThemeResource ValueBrush}"/></Grid></Border>
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Fri" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="22C" Foreground="{ThemeResource ValueBrush}"/></Grid></Border>
                <Border CornerRadius="10" Background="#121D2F" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sat" Foreground="{ThemeResource ValueBrush}"/><TextBlock Grid.Column="1" Text="24C" Foreground="{ThemeResource ValueBrush}"/></Grid></Border>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2" CornerRadius="18"
                  BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                  Background="#060E1A" Padding="14,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="WORLD OVERVIEW"
                         FontFamily="{ThemeResource MonoFontFamily}" FontSize="11" CharacterSpacing="120"
                         Foreground="{ThemeResource LabelBrush}"/>
              <Canvas Grid.Row="1" x:Name="WxMapCanvas" Margin="0,10,0,0">
                <Rectangle Canvas.Left="10" Canvas.Top="20" Width="130" Height="70" Fill="#17344E" RadiusX="20" RadiusY="20"/>
                <Rectangle Canvas.Left="160" Canvas.Top="10" Width="90" Height="80" Fill="#17344E" RadiusX="16" RadiusY="16"/>
                <Rectangle Canvas.Left="270" Canvas.Top="14" Width="150" Height="70" Fill="#17344E" RadiusX="18" RadiusY="18"/>
                <Rectangle Canvas.Left="315" Canvas.Top="120" Width="80" Height="45" Fill="#17344E" RadiusX="14" RadiusY="14"/>

                <Ellipse Canvas.Left="358" Canvas.Top="68" Width="12" Height="12" Fill="{ThemeResource AccentCyanBrush}"/>
                <Border Canvas.Left="348" Canvas.Top="46" CornerRadius="5" Background="#CC1D4570"
                        BorderBrush="{ThemeResource AccentCyanBrush}" BorderThickness="1" Padding="6,2">
                  <StackPanel>
                    <TextBlock Text="Tokyo" FontFamily="{ThemeResource MonoFontFamily}" FontSize="9" Foreground="{ThemeResource ValueBrush}"/>
                    <TextBlock Text="22C" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="10" Foreground="{ThemeResource AccentCyanBrush}"/>
                  </StackPanel>
                </Border>
              </Canvas>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="4" CornerRadius="16"
                BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1"
                Background="#0C1525" Padding="14,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="OVERVIEW"
                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="11" CharacterSpacing="120"
                       Foreground="{ThemeResource LabelBrush}"/>
            <Canvas Grid.Row="1" x:Name="WxOverviewCanvas">
              <Rectangle Canvas.Left="0" Canvas.Top="50" Width="560" Height="2" Fill="#404CC3FF"/>
              <Ellipse x:Name="WxOverviewLine" Canvas.Left="360" Canvas.Top="26" Width="8" Height="8" Fill="{ThemeResource AccentCyanBrush}"/>
              <Rectangle x:Name="WxOverviewFill" Canvas.Left="0" Canvas.Top="52" Width="560" Height="24" Fill="#1A4CC3FF"/>
            </Canvas>
            <Grid Grid.Row="2" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Sun" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Mon" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="Tue" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="Wed" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="Thu" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="Fri" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="6" Text="Sat" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>