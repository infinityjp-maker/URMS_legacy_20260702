<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.FlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid x:Name="RootGrid" Padding="12" Opacity="0">
    <Rectangle Opacity="0.016" Fill="{ThemeResource GlobalNoiseBrush}"/>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="18" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Margin="8,14,8,14" Spacing="8">
          <Button Click="OnNavDashboard" CornerRadius="14" Height="64" Padding="12,8" Background="Transparent" BorderBrush="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"><StackPanel><FontIcon Glyph="&#xE8F1;" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="DASH" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="110" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button Click="OnNavWeather" CornerRadius="14" Height="64" Padding="12,8" Background="Transparent" BorderBrush="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"><StackPanel><FontIcon Glyph="&#xE706;" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="WTHR" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="110" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button Click="OnNavSystem" CornerRadius="14" Height="64" Padding="12,8" Background="Transparent" BorderBrush="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"><StackPanel><FontIcon Glyph="&#xE7C1;" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="SYS" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="110" HorizontalAlignment="Center"/></StackPanel></Button>
          <Grid><Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Fill="{ThemeResource AccentCyanBrush}"/><Button CornerRadius="14" Height="64" Padding="12,8" Background="{ThemeResource SidebarActiveBrush}" BorderBrush="{ThemeResource AccentCyanBrush}"><StackPanel><FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Center"/><TextBlock Text="FLOW" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="110" HorizontalAlignment="Center"/></StackPanel></Button></Grid>
          <Button Click="OnNavLog" CornerRadius="14" Height="64" Padding="12,8" Background="Transparent" BorderBrush="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"><StackPanel><FontIcon Glyph="&#xE9D2;" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="LOG" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="110" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button Click="OnNavSettings" CornerRadius="14" Height="64" Padding="12,8" Background="Transparent" BorderBrush="Transparent" PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"><StackPanel><FontIcon Glyph="&#xE713;" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="SET" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10" CharacterSpacing="110" HorizontalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" Background="{ThemeResource MaterialPanelStrongBrush}" Padding="24,0">
          <Grid><TextBlock Text="FLOW" FontFamily="{ThemeResource DisplayFontFamily}" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource HeaderTitleBrush}"/></Grid>
        </Border>

        <Border Grid.Row="1" CornerRadius="12" Background="{ThemeResource MatteCardBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" Padding="12">
          <Canvas x:Name="FlowCanvas" Height="540">
            <Border x:Name="Node1" Canvas.Left="40" Canvas.Top="60" CornerRadius="12" Padding="12" Width="180" Background="{ThemeResource GlassSecondaryBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" PointerEntered="OnNodePointerEntered" PointerExited="OnNodePointerExited" Tapped="OnNodeTapped"><TextBlock Text="INGEST\n● RUNNING" Foreground="{ThemeResource AccentCyanBrush}" FontFamily="{ThemeResource MonoFontFamily}"/></Border>
            <Border x:Name="Node2" Canvas.Left="300" Canvas.Top="60" CornerRadius="12" Padding="12" Width="180" Background="{ThemeResource GlassSecondaryBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" PointerEntered="OnNodePointerEntered" PointerExited="OnNodePointerExited" Tapped="OnNodeTapped"><TextBlock Text="VALIDATE\n● WAITING" Foreground="{ThemeResource AccentAmberBrush}" FontFamily="{ThemeResource MonoFontFamily}"/></Border>
            <Border x:Name="Node3" Canvas.Left="560" Canvas.Top="60" CornerRadius="12" Padding="12" Width="180" Background="{ThemeResource GlassSecondaryBrush}" BorderBrush="{ThemeResource MaterialStrokeSoftBrush}" BorderThickness="1" PointerEntered="OnNodePointerEntered" PointerExited="OnNodePointerExited" Tapped="OnNodeTapped"><TextBlock Text="DEPLOY\n● FAILED" Foreground="{ThemeResource AccentRedBrush}" FontFamily="{ThemeResource MonoFontFamily}"/></Border>

            <Line X1="220" Y1="110" X2="300" Y2="110" Stroke="{ThemeResource CyanLineBrush}" StrokeThickness="2"/>
            <Line X1="480" Y1="110" X2="560" Y2="110" Stroke="{ThemeResource CyanLineBrush}" StrokeThickness="2"/>
            <TextBlock Canvas.Left="258" Canvas.Top="100" Text=">" Foreground="{ThemeResource AccentCyanBrush}"/>
            <TextBlock Canvas.Left="518" Canvas.Top="100" Text=">" Foreground="{ThemeResource AccentCyanBrush}"/>
          </Canvas>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
