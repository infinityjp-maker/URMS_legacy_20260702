<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="URMS.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:URMS.WinUI"
    xmlns:controls="using:URMS.WinUI.Controls"
    Title="URMS">

  <Grid>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Q" Modifiers="Control" Invoked="OnKeyboardAccelerator_Q"/>
      <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnKeyboardAccelerator_E"/>
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnKeyboardAccelerator_W"/>
    </Grid.KeyboardAccelerators>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
      <controls:HeaderControl x:Name="HeaderHost"
                              DoubleTapped="OnHeaderDoubleTapped"
                              MinimizeClicked="OnHeaderMinimizeClicked"
                              MaximizeClicked="OnHeaderMaximizeClicked"
                              RestoreClicked="OnHeaderRestoreClicked"
                              CloseClicked="OnHeaderCloseClicked"/>
    </Grid>

    <Grid Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}" Margin="2,0,2,2">
      <Grid.RowDefinitions>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Canvas x:Name="BgStarsCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>

      <Grid x:Name="NebulaGrid" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
        <Rectangle Fill="{ThemeResource AppDepthGradient}"/>
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.18,0.22" RadiusX="0.58" RadiusY="0.42">
              <GradientStop Color="#18385674" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.82,0.78" RadiusX="0.46" RadiusY="0.32">
              <GradientStop Color="#16283A5B" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.52,0.08" RadiusX="0.44" RadiusY="0.24">
              <GradientStop Color="#143A5368" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,0.55" RadiusX="0.7" RadiusY="0.48">
              <GradientStop Color="#0F182431" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <Canvas x:Name="BgGridCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>
      <Canvas x:Name="BgPerspCanvas" Grid.Row="1" IsHitTestVisible="False"/>
      <Canvas x:Name="BgMatrixCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.035"/>
      <Rectangle Grid.Row="0" Grid.RowSpan="2" Opacity="0.012" Fill="{ThemeResource GlobalNoiseBrush}" IsHitTestVisible="False"/>

      <Grid Grid.Row="1" IsHitTestVisible="False">
        <Canvas Width="88" Height="88" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0">
          <Line X1="0" Y1="88" X2="0" Y2="0" Stroke="#274B6075" StrokeThickness="2"/>
          <Line X1="0" Y1="0" X2="88" Y2="0" Stroke="#274B6075" StrokeThickness="2"/>
        </Canvas>
        <Canvas Width="88" Height="88" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0">
          <Line X1="88" Y1="88" X2="88" Y2="0" Stroke="#274B6075" StrokeThickness="2"/>
          <Line X1="0" Y1="0" X2="88" Y2="0" Stroke="#274B6075" StrokeThickness="2"/>
        </Canvas>
        <Canvas Width="88" Height="88" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,18">
          <Line X1="0" Y1="0" X2="0" Y2="88" Stroke="#274B6075" StrokeThickness="2"/>
          <Line X1="0" Y1="88" X2="88" Y2="88" Stroke="#274B6075" StrokeThickness="2"/>
        </Canvas>
        <Canvas Width="88" Height="88" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
          <Line X1="88" Y1="0" X2="88" Y2="88" Stroke="#274B6075" StrokeThickness="2"/>
          <Line X1="0" Y1="88" X2="88" Y2="88" Stroke="#274B6075" StrokeThickness="2"/>
        </Canvas>
      </Grid>

      <Grid Grid.Row="1">
        <Frame x:Name="ContentFrame"/>
        <Grid x:Name="BootOverlayGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      </Grid>

      <Rectangle x:Name="ScanLine" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.6">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent" Offset="0"/>
            <GradientStop Color="#416E88A0" Offset="0.4"/>
            <GradientStop Color="#7FA1B9D1" Offset="0.5"/>
            <GradientStop Color="#416E88A0" Offset="0.6"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.RenderTransform>
          <TranslateTransform x:Name="ScanLineTranslate"/>
        </Rectangle.RenderTransform>
      </Rectangle>
    </Grid>
  </Grid>
</Window>
