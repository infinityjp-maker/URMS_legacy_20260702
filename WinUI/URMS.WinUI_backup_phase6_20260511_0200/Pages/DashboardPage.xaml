<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="URMS.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:URMS.WinUI.Controls"
    Background="Transparent">

  <Page.Resources>
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="CharacterSpacing" Value="140"/>
      <Setter Property="Foreground" Value="{ThemeResource SectionHeaderBrush}"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Rectangle Opacity="0.012" Fill="{ThemeResource GlobalNoiseBrush}"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="1820" HorizontalAlignment="Center" Padding="32,28,32,32" Spacing="52">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock FontFamily="Consolas" FontSize="24" CharacterSpacing="320" Foreground="{ThemeResource HeroCyanBrush}" Text="DASHBOARD / HIGH-END MATERIAL OPS"/>
            <TextBlock Text="UNIFIED RESOURCE MANAGEMENT SYSTEM / MATERIAL DRAMA ARCHITECTURE" FontFamily="Consolas" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource HeroSubBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="SESSION" FontFamily="Consolas" FontSize="8" CharacterSpacing="150" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="TxtSessionId" Text="---" FontFamily="Consolas" FontSize="12" CharacterSpacing="120" Foreground="{ThemeResource ValueBrush}" HorizontalAlignment="Right"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
              <Button x:Name="BtnWinMin" Content="—" Click="OnWinMinClick"/>
              <Button x:Name="BtnWinMax" Content="□" Click="OnWinMaxClick"/>
              <Button x:Name="BtnWinClose" Content="×" Click="OnWinCloseClick"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="18">
          <TextBlock Text="SYSTEM LAYER / 光量 100%" Style="{StaticResource SectionLabelStyle}"/>
          <Grid ColumnSpacing="48" RowSpacing="48">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ctrl:CardControl x:Name="CardSysmon" Grid.Row="0" Grid.Column="0" Margin="0,12,0,12" BaseGlowOpacity="0.24" HoverGlowOpacity="0.28" IsPrimaryTone="True" MaterialIntensity="1.4" OpticalDepth="1.5" ShadowDepth="1.6" InfoDensity="1.1" TitleText="SYSTEM HEALTH" MainValueText="98 / 100" SubInfoText="Primary Node Integrity / Density High" IconGlyph="&#xE9CE;">
              <StackPanel Spacing="18">
                <Border Background="#10243246" BorderBrush="#33546C84" BorderThickness="1" CornerRadius="12" Padding="14,10">
                  <TextBlock Text="PRIMARY NODE / LUMINANCE FULL / SHADOW +40%" FontFamily="Consolas" FontSize="9" CharacterSpacing="100" Foreground="{ThemeResource CardTitleBrush}"/>
                </Border>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="6"><TextBlock Text="CPU" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/><ctrl:AnalogGauge x:Name="GaugeCpu" Value="72" Label="CPU" GaugeColor="#8FB4CF" Width="112" Height="90"/></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="MEMORY" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/><ctrl:AnalogGauge x:Name="GaugeRam" Value="58" Label="RAM" GaugeColor="#87B79E" Width="112" Height="90"/></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="GPU" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Center"/><ctrl:AnalogGauge x:Name="GaugeGpu" Value="45" Label="GPU" GaugeColor="#9B9AC7" Width="112" Height="90"/></StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <TextBlock Text="C:" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" x:Name="BarDiskC" Height="8" Foreground="{ThemeResource AccentCyanBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                  <TextBlock Grid.Column="2" x:Name="TxtDiskC" Text="68%" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <TextBlock Text="D:" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" x:Name="BarDiskD" Height="8" Foreground="{ThemeResource AccentGreenBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                  <TextBlock Grid.Column="2" x:Name="TxtDiskD" Text="42%" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <TextBlock Text="NAS" Foreground="{ThemeResource ValueBrush}" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" x:Name="BarDiskNas" Height="8" Foreground="{ThemeResource AccentPurpleBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                  <TextBlock Grid.Column="2" x:Name="TxtDiskNas" Text="31%" Foreground="{ThemeResource LabelBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="CardTask" Grid.Row="0" Grid.Column="1" Margin="0,12,0,12" BaseGlowOpacity="0.24" HoverGlowOpacity="0.28" IsPrimaryTone="True" MaterialIntensity="1.4" OpticalDepth="1.5" ShadowDepth="1.6" InfoDensity="1.1" TitleText="TASKS" MainValueText="5 / 8" SubInfoText="Operational queue / Density High" IconGlyph="&#xE823;">
              <StackPanel Spacing="16">
                <TextBlock x:Name="TxtCardTask" Text="TASKS" FontFamily="Consolas" FontSize="10" CharacterSpacing="160" Foreground="{ThemeResource CardTitleBrush}"/>
                <ProgressBar x:Name="BarTaskPct" Value="62" Height="10" Foreground="{ThemeResource AccentGreenBrush}" Background="{ThemeResource ProgressTrackBrush}"/>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#122A3D33" BorderBrush="#29546A5A" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="DONE" Foreground="{ThemeResource LabelBrush}" FontFamily="Consolas" FontSize="8"/><TextBlock Text="5" Foreground="{ThemeResource ValueBrush}" FontSize="20"/></StackPanel></Border>
                  <Border Grid.Column="1" Background="#122F2A22" BorderBrush="#294A4A54" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="OPEN" Foreground="{ThemeResource LabelBrush}" FontFamily="Consolas" FontSize="8"/><TextBlock Text="3" Foreground="{ThemeResource ValueBrush}" FontSize="20"/></StackPanel></Border>
                  <Border Grid.Column="2" Background="#122E2622" BorderBrush="#294B4A54" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="PRIORITY" Foreground="{ThemeResource LabelBrush}" FontFamily="Consolas" FontSize="8"/><TextBlock Text="1" Foreground="{ThemeResource ValueBrush}" FontSize="20"/></StackPanel></Border>
                </Grid>
              </StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="CardWeather" Grid.Row="1" Grid.Column="0" Margin="0,6,0,6" BaseGlowOpacity="0.18" HoverGlowOpacity="0.21" MaterialIntensity="1.2" ShadowDepth="1.2" TitleText="WEATHER" MainValueText="22°C" SubInfoText="Tokyo atmospheric envelope" IconGlyph="&#xE706;">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ctrl:WeatherAnimation x:Name="WxAnim" Condition="sunny" Height="82" Width="82"/>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtCardWeather" Text="WEATHER" FontFamily="Consolas" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource CardTitleBrush}"/>
                  <TextBlock x:Name="TxtWeatherTemp" Text="22°C" FontFamily="Consolas" FontSize="32" Foreground="{ThemeResource ValueBrush}"/>
                  <TextBlock x:Name="TxtWeatherDesc" Text="Tokyo · Minato" Foreground="{ThemeResource LabelBrush}"/>
                </StackPanel>
              </Grid>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="CardSecurity" Grid.Row="1" Grid.Column="1" Margin="0,6,0,6" BaseGlowOpacity="0.18" HoverGlowOpacity="0.21" MaterialIntensity="1.2" ShadowDepth="1.2" TitleText="SECURITY" MainValueText="PROTECTED" SubInfoText="Protected perimeter / Medium density" IconGlyph="&#xE72E;">
              <StackPanel Spacing="14">
                <TextBlock Text="SECURITY" FontFamily="Consolas" FontSize="10" CharacterSpacing="150" Foreground="{ThemeResource CardTitleBrush}"/>
                <Border Background="#13223022" BorderBrush="#28506257" BorderThickness="1" CornerRadius="12" Padding="14,12">
                  <TextBlock Text="Threat surface stable / patch compliance nominal / auth chain healthy" Foreground="{ThemeResource ValueBrush}" TextWrapping="WrapWholeWords"/>
                </Border>
              </StackPanel>
            </ctrl:CardControl>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="18">
          <TextBlock Text="SUBSYSTEM LAYER / 光量 60%" Style="{StaticResource SectionLabelStyle}"/>
          <Grid ColumnSpacing="48" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*"/>
              <ColumnDefinition Width="1.6*"/>
              <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <ctrl:CardControl x:Name="CardSchedule" Grid.Column="0" Margin="0,2,0,2" BaseGlowOpacity="0.12" HoverGlowOpacity="0.14" MaterialIntensity="0.8" OpticalDepth="0.6" ShadowDepth="0.8" InfoDensity="0.9" TitleText="SCHEDULE" MainValueText="09:30" SubInfoText="Morning sync / review later" IconGlyph="&#xE787;">
              <StackPanel Spacing="10">
                <TextBlock x:Name="TxtCardSchedule" Text="SCHEDULE" FontFamily="Consolas" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource CardTitleBrush}"/>
                <TextBlock x:Name="TxtSchedNext" Text="朝会 (15min)" Foreground="{ThemeResource ValueBrush}"/>
                <TextBlock Text="13:00 週次レビュー" Foreground="{ThemeResource LabelBrush}"/>
              </StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="CardCalendar" Grid.Column="1" Margin="0,2,0,2" BaseGlowOpacity="0.12" HoverGlowOpacity="0.14" MaterialIntensity="0.8" OpticalDepth="0.6" ShadowDepth="0.8" InfoDensity="0.9" TitleText="CALENDAR" MainValueText="2026/05" SubInfoText="Calendar field / medium density" IconGlyph="&#xE787;">
              <StackPanel Spacing="12">
                <TextBlock x:Name="TxtCalendarMonth" Text="2026/05" FontFamily="Consolas" FontSize="14" Foreground="{ThemeResource ValueBrush}"/>
                <Grid ColumnSpacing="6" RowSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="S" HorizontalAlignment="Center" Foreground="#D2A8AF"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="M" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="T" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="W" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="4" Text="T" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="5" Text="F" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="6" Text="S" HorizontalAlignment="Center" Foreground="#D2A8AF"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="4" HorizontalAlignment="Center" Foreground="#D2A8AF"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="5" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="6" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <Border Grid.Row="1" Grid.Column="3" Background="#29425B71" CornerRadius="8" Padding="4"><TextBlock Text="7" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/></Border>
                  <TextBlock Grid.Row="1" Grid.Column="4" Text="8" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="5" Text="9" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="6" Text="10" HorizontalAlignment="Center" Foreground="#D2A8AF"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="11" HorizontalAlignment="Center" Foreground="#D2A8AF"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="12" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="13" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="3" Text="14" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="4" Text="15" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="5" Text="16" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="6" Text="17" HorizontalAlignment="Center" Foreground="#D2A8AF"/>
                </Grid>
              </StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="CardNetwork" Grid.Column="2" Margin="0,2,0,2" BaseGlowOpacity="0.12" HoverGlowOpacity="0.14" MaterialIntensity="0.8" OpticalDepth="0.6" ShadowDepth="0.8" InfoDensity="0.9" TitleText="NETWORK" MainValueText="24 hosts" SubInfoText="Latency 12 ms / Uptime 100%" IconGlyph="&#xE128;">
              <StackPanel Spacing="10">
                <TextBlock Text="NETWORK" FontFamily="Consolas" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource CardTitleBrush}"/>
                <Canvas x:Name="NetWaveCanvas" Height="36"/>
                <TextBlock Text="Latency 12 ms / Uptime 100%" Foreground="{ThemeResource LabelBrush}"/>
              </StackPanel>
            </ctrl:CardControl>
          </Grid>

          <Grid ColumnSpacing="48">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ctrl:CardControl x:Name="SubAsset" Grid.Column="0" Margin="0,2,0,2" BaseGlowOpacity="0.13" HoverGlowOpacity="0.15" MinHeight="150" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.85"><StackPanel Spacing="8"><TextBlock x:Name="TxtSubAsset" Text="Management" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtAssetStatus" Text="ACTIVE" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource ValueBrush}"/></StackPanel></ctrl:CardControl>
            <ctrl:CardControl x:Name="SubDisk" Grid.Column="1" Margin="0,2,0,2" BaseGlowOpacity="0.13" HoverGlowOpacity="0.15" MinHeight="150" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.85"><StackPanel Spacing="8"><TextBlock x:Name="TxtSubDisk" Text="Management" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtDiskStatus" Text="ACTIVE" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource ValueBrush}"/></StackPanel></ctrl:CardControl>
            <ctrl:CardControl x:Name="SubContent" Grid.Column="2" Margin="0,2,0,2" BaseGlowOpacity="0.13" HoverGlowOpacity="0.15" MinHeight="150" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.85"><StackPanel Spacing="8"><TextBlock x:Name="TxtSubContent" Text="Management" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtContentStatus" Text="ACTIVE" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource ValueBrush}"/></StackPanel></ctrl:CardControl>
            <ctrl:CardControl x:Name="SubLog" Grid.Column="3" Margin="0,2,0,2" BaseGlowOpacity="0.13" HoverGlowOpacity="0.15" MinHeight="150" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.85"><StackPanel Spacing="8"><TextBlock x:Name="TxtSubLog" Text="Management" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtLogStatus" Text="ACTIVE" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource ValueBrush}"/></StackPanel></ctrl:CardControl>
            <ctrl:CardControl x:Name="SubSecurity" Grid.Column="4" Margin="0,2,0,2" BaseGlowOpacity="0.13" HoverGlowOpacity="0.15" MinHeight="150" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.85"><StackPanel Spacing="8"><TextBlock x:Name="TxtSubSecurity" Text="Subsystem" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtSecurityStatus" Text="ACTIVE" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource ValueBrush}"/></StackPanel></ctrl:CardControl>
            <ctrl:CardControl x:Name="SubExtra" Grid.Column="5" Margin="0,2,0,2" BaseGlowOpacity="0.13" HoverGlowOpacity="0.15" MinHeight="150" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.85"><StackPanel Spacing="8"><TextBlock x:Name="TxtSubExtra" Text="Subsystem Slot" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}"/><TextBlock x:Name="TxtExtraStatus" Text="ACTIVE" HorizontalAlignment="Center" FontSize="16" Foreground="{ThemeResource ValueBrush}"/></StackPanel></ctrl:CardControl>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="18">
          <TextBlock Text="OPERATION LAYER / 光量 30%" Style="{StaticResource SectionLabelStyle}"/>
          <Grid ColumnSpacing="48">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ctrl:CardControl x:Name="OperationStateCard" Grid.Column="0" BaseGlowOpacity="0.10" HoverGlowOpacity="0.12" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.8" TitleText="STATE" MainValueText="NOMINAL" SubInfoText="Low density" IconGlyph="&#xE7BA;">
              <StackPanel Spacing="8"><TextBlock x:Name="TxtOpHealth" Text="NOMINAL" FontSize="16" Foreground="{ThemeResource ValueBrush}"/><TextBlock x:Name="TxtOpAlerts" Text="0" Foreground="{ThemeResource AccentAmberBrush}"/><TextBlock x:Name="TxtOpTasks" Text="2 active" Foreground="{ThemeResource LabelBrush}"/></StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="OperationWorkflowCard" Grid.Column="1" BaseGlowOpacity="0.10" HoverGlowOpacity="0.12" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.8" TitleText="WORKFLOW" MainValueText="PIPELINE" SubInfoText="Low density" IconGlyph="&#xE7C1;">
              <ctrl:WorkflowCard x:Name="OpWorkflowCard"/>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="OperationActionCard" Grid.Column="2" BaseGlowOpacity="0.10" HoverGlowOpacity="0.12" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.8" TitleText="ACTIONS" MainValueText="5" SubInfoText="Quick action deck" IconGlyph="&#xE8EF;">
              <StackPanel Spacing="8">
                <Button x:Name="BtnOpLock" Content="Lock" Height="32" Background="#16202D3C" BorderBrush="#2C495D71" BorderThickness="1"/>
                <Button x:Name="BtnOpRestart" Content="Restart" Height="32" Background="#16202D3C" BorderBrush="#2C495D71" BorderThickness="1"/>
                <Button x:Name="BtnOpLogOff" Content="LogOff" Height="32" Background="#16202D3C" BorderBrush="#2C495D71" BorderThickness="1"/>
                <Button x:Name="BtnOpDeploy" Content="Deploy" Height="32" Background="#16202D3C" BorderBrush="#2C495D71" BorderThickness="1"/>
                <Button x:Name="BtnOpValidate" Content="Validate" Height="32" Background="#16202D3C" BorderBrush="#2C495D71" BorderThickness="1"/>
              </StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="OperationRunningTaskCard" Grid.Column="3" BaseGlowOpacity="0.10" HoverGlowOpacity="0.12" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.8" TitleText="RUNNING" MainValueText="2" SubInfoText="Task flow" IconGlyph="&#xE823;">
              <StackPanel Spacing="8"><TextBlock Text="Backup validation" Foreground="{ThemeResource ValueBrush}"/><TextBlock Text="Artifact sweep" Foreground="{ThemeResource LabelBrush}"/></StackPanel>
            </ctrl:CardControl>

            <ctrl:CardControl x:Name="OperationAlertsCard" Grid.Column="4" BaseGlowOpacity="0.10" HoverGlowOpacity="0.12" MaterialIntensity="0.8" OpticalDepth="0.6" InfoDensity="0.8" TitleText="ALERTS" MainValueText="5" SubInfoText="Alert density low" IconGlyph="&#xE7BA;">
              <StackPanel Spacing="8"><TextBlock x:Name="TxtAlertCritical" Text="critical: 0" Foreground="{ThemeResource AccentRedBrush}"/><TextBlock x:Name="TxtAlertWarn" Text="warning: 1" Foreground="{ThemeResource AccentAmberBrush}"/><TextBlock x:Name="TxtAlertInfo" Text="info: 4" Foreground="{ThemeResource AccentCyanBrush}"/></StackPanel>
            </ctrl:CardControl>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>