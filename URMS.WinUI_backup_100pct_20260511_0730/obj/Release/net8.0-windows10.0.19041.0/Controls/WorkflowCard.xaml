<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="URMS.WinUI.Controls.WorkflowCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid>
    <Border CornerRadius="14" BorderThickness="1" BorderBrush="#385063" Background="#C90A131C" Padding="18,16,18,16">
      <Grid>
        <Rectangle RadiusX="14" RadiusY="14" Opacity="0.022" Fill="{ThemeResource GlobalNoiseBrush}"/>
        <Rectangle Height="22" VerticalAlignment="Top" Margin="1,1,1,0" RadiusX="13" RadiusY="13" Opacity="0.20">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#48FFFFFF" Offset="0"/>
              <GradientStop Color="#10D4E7F7" Offset="0.6"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <StackPanel Spacing="14">
          <TextBlock Text="PIPELINE FLOW / OPTICAL DEPTH 4" FontFamily="Consolas" FontSize="9" CharacterSpacing="120" Foreground="{ThemeResource CardTitleBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='26' x:Name="IcoCommit" Grid.Row="0" Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource AccentCyanBrush}"/>
              <Ellipse x:ConnectionId='27' x:Name="DotCommit" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource AccentCyanBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='28' x:Name="TxtCommit" Grid.Row="2" Text="Commit" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource AccentCyanBrush}"/>
              <TextBlock x:ConnectionId='29' x:Name="TxtMetaCommit" Grid.Row="3" Text="OK" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
            <TextBlock Text=">" Foreground="#64788F" VerticalAlignment="Center" FontSize="12"/>
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='22' x:Name="IcoBuild" Grid.Row="0" Glyph="&#xE956;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <Ellipse x:ConnectionId='23' x:Name="DotBuild" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='24' x:Name="TxtBuild" Grid.Row="2" Text="Build" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:ConnectionId='25' x:Name="TxtMetaBuild" Grid.Row="3" Text="OK" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
            <TextBlock Text=">" Foreground="#64788F" VerticalAlignment="Center" FontSize="12"/>
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='18' x:Name="IcoTest" Grid.Row="0" Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <Ellipse x:ConnectionId='19' x:Name="DotTest" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='20' x:Name="TxtTest" Grid.Row="2" Text="Test" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:ConnectionId='21' x:Name="TxtMetaTest" Grid.Row="3" Text="OK" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
            <TextBlock Text=">" Foreground="#64788F" VerticalAlignment="Center" FontSize="12"/>
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='14' x:Name="IcoCI" Grid.Row="0" Glyph="&#xE7C1;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <Ellipse x:ConnectionId='15' x:Name="DotCI" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='16' x:Name="TxtCI" Grid.Row="2" Text="CI" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:ConnectionId='17' x:Name="TxtMetaCI" Grid.Row="3" Text="RUN" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
            <TextBlock Text=">" Foreground="#64788F" VerticalAlignment="Center" FontSize="12"/>
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='10' x:Name="IcoCD" Grid.Row="0" Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <Ellipse x:ConnectionId='11' x:Name="DotCD" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='12' x:Name="TxtCD" Grid.Row="2" Text="CD" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:ConnectionId='13' x:Name="TxtMetaCD" Grid.Row="3" Text="WAIT" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
            <TextBlock Text=">" Foreground="#64788F" VerticalAlignment="Center" FontSize="12"/>
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='6' x:Name="IcoDeploy" Grid.Row="0" Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <Ellipse x:ConnectionId='7' x:Name="DotDeploy" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='8' x:Name="TxtDeploy" Grid.Row="2" Text="Deploy" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:ConnectionId='9' x:Name="TxtMetaDeploy" Grid.Row="3" Text="WAIT" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
            <TextBlock Text=">" Foreground="#64788F" VerticalAlignment="Center" FontSize="12"/>
            <Grid MinWidth="84">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <FontIcon x:ConnectionId='2' x:Name="IcoPR" Grid.Row="0" Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <Ellipse x:ConnectionId='3' x:Name="DotPR" Grid.Row="1" Width="12" Height="12" Fill="{ThemeResource ValueBrush}" HorizontalAlignment="Center" Margin="0,6,0,4"/>
              <TextBlock x:ConnectionId='4' x:Name="TxtPR" Grid.Row="2" Text="PR" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource ValueBrush}"/>
              <TextBlock x:ConnectionId='5' x:Name="TxtMetaPR" Grid.Row="3" Text="WAIT" FontFamily="Consolas" FontSize="7" HorizontalAlignment="Center" Foreground="{ThemeResource LabelBrush}" Margin="0,3,0,0"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

